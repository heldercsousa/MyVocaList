# Environment variables for Claude Code integrations
# Each developer: rename this file to .env.local, fill in your keys, then run:
#   . .\.claude\scripts\load-env.ps1

PLAYWRIGHT_MCP_EXTENSION_TOKEN=your-playwright-token-here
CONTEXT7_API_KEY=your-context7-api-key-here

# Android release signing (used by /sln-deploy-android)
# Keystore: C:\Users\<you>\keystrokes\myvocalist-release.jks  alias: myvocalist
ANDROID_KEYSTORE_PASS=your-keystore-password-here
ANDROID_KEY_PASS=your-key-password-here
