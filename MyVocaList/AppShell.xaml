<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyVocaList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:models="clr-namespace:MyVocaList.UI.Models"
    xmlns:venues="clr-namespace:MyVocaList.UI.Pages.Venues"
    xmlns:people="clr-namespace:MyVocaList.UI.Pages.People"
    xmlns:artists="clr-namespace:MyVocaList.UI.Pages.Artists"
    xmlns:songs="clr-namespace:MyVocaList.UI.Pages.Songs"
    xmlns:backup="clr-namespace:MyVocaList.UI.Pages.BackupRestore"
    xmlns:settings="clr-namespace:MyVocaList.UI.Pages.Settings"
    xmlns:about="clr-namespace:MyVocaList.UI.Pages.About"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    Title="MyVocaList"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{StaticResource Surface}">

    <!-- Flyout Header: App branding -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="16,24,16,16" Spacing="4"
                             BackgroundColor="{StaticResource Surface}">
            <Label Text="MyVocaList"
                   StyleClass="Title.Large"
                   FontFamily="RobotoBold"
                   TextColor="{StaticResource Primary}" />
            <Label Text="Karaoke Queue Manager"
                   StyleClass="Body.Medium"
                   TextColor="{StaticResource OnSurfaceVariant}" />
            <BoxView Style="{StaticResource Divider}" Margin="0,12,0,0" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- Flyout Content: Grouped navigation menu -->
    <Shell.FlyoutContentTemplate>
        <DataTemplate x:DataType="vm:AppShellViewModel">
            <ScrollView BackgroundColor="{StaticResource Surface}">
                <VerticalStackLayout Padding="12,0" Spacing="16"
                                     BindableLayout.ItemsSource="{Binding MenuGroups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MenuGroup">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding GroupTitle}"
                                       Style="{StaticResource NavDrawerSectionHeader}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:MenuItemDescription">
                                            <buttons:SfButton Text="{Binding Name}"
                                                              ImageSource="{Binding IconSource}"
                                                              Style="{StaticResource SfFlyoutMenuButton}"
                                                              Command="{Binding NavigateCommand}"
                                                              CommandParameter="{Binding Route}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
    </Shell.FlyoutContentTemplate>

    <!-- Page Routes (hidden from default flyout, navigated via ViewModel) -->
    <FlyoutItem Route="venues" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate venues:VenuesSfPage}" />
    </FlyoutItem>

    <FlyoutItem Route="people" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate people:PeopleSfPage}" />
    </FlyoutItem>

    <FlyoutItem Route="artists" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate artists:ArtistsSfPage}" />
    </FlyoutItem>

    <FlyoutItem Route="songs" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate songs:SongsSfPage}" />
    </FlyoutItem>

    <FlyoutItem Route="preferences" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate settings:SettingsSfPage}" />
    </FlyoutItem>

    <FlyoutItem Route="backup" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate backup:BackupRestorePage}" />
    </FlyoutItem>

    <FlyoutItem Route="settings" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate settings:SettingsSfPage}" />
    </FlyoutItem>

    <FlyoutItem Route="about" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate about:AboutPage}" />
    </FlyoutItem>

</Shell>
