<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyVocaList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:samples="clr-namespace:MyVocaList.UI.Pages.Samples"
    Title="MyVocaList">

    <TabBar>
        <Tab Title="Home">
            <ShellContent ContentTemplate="{DataTemplate ContentPage}" />
        </Tab>

        <!-- DEBUG: Samples Tab -->
        <Tab Title="Samples">
            <ShellContent ContentTemplate="{DataTemplate samples:SamplesMenuPage}" />
        </Tab>
    </TabBar>
</Shell>