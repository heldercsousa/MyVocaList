    <!-- ============================================================================ -->
    <!-- GRADIENTS (Using Tonal Palette Values)                                     -->
    <!-- ============================================================================ -->

    <!-- App Background Gradient (Dark Purple) -->
    <LinearGradientBrush x:Key="AppBackgroundGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Neutral10}" Offset="0.0" />
        <GradientStop Color="{StaticResource Primary10}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Card Background Gradient (Diagonal Purple) -->
    <LinearGradientBrush x:Key="CardBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary20}" Offset="0.0" />
        <GradientStop Color="{StaticResource Secondary30}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Selected Item Gradient (Pink to Purple) -->
    <LinearGradientBrush x:Key="SelectedGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Primary30}" Offset="0.0" />
        <GradientStop Color="{StaticResource Secondary40}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Button Gradient (Bright Pink to Purple) -->
    <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Primary70}" Offset="0.0" />
        <GradientStop Color="{StaticResource Secondary70}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- FAB Gradient (Gold to Pink) -->
    <LinearGradientBrush x:Key="FabGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Tertiary80}" Offset="0.0" />
        <GradientStop Color="{StaticResource Primary70}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ============================================================================ -->
    <!-- SEMANTIC COLORS (For Specific Use Cases)                                   -->
    <!-- ============================================================================ -->

    <!-- Success (for positive feedback) -->
    <Color x:Key="Success">#2E7D32</Color>
    <Color x:Key="OnSuccess">#FFFFFF</Color>

    <!-- Warning (for caution states) -->
    <Color x:Key="Warning">#FF9800</Color>
    <Color x:Key="OnWarning">#FFFFFF</Color>

    <!-- Info (for informational elements) -->
    <Color x:Key="Info">#2196F3</Color>
    <Color x:Key="OnInfo">#FFFFFF</Color>
