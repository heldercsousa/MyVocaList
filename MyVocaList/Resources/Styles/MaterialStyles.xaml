<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui">

    <!-- ================================================================ -->
    <!-- CONTAINER STYLES                                                 -->
    <!-- ================================================================ -->

    <Style x:Key="PageContainer" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="SectionContainer" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <!-- ================================================================ -->
    <!-- DEVEXPRESS BUTTON STYLES (MD3-Inspired)                          -->
    <!-- ================================================================ -->

    <Style TargetType="dx:DXButton" x:Key="FilledButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="PressedBackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="PressedTextColor" Value="{StaticResource OnPrimary}" />
    </Style>

    <Style TargetType="dx:DXButton" x:Key="FilledTonalButton">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryContainer}" />
        <Setter Property="TextColor" Value="{StaticResource OnSecondaryContainer}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style TargetType="dx:DXButton" x:Key="OutlinedButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderColor" Value="{StaticResource Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style TargetType="dx:DXButton" x:Key="TextButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <!-- ================================================================ -->
    <!-- DEVEXPRESS EDITOR STYLES                                         -->
    <!-- ================================================================ -->

    <Style TargetType="dx:TextEdit">
        <Setter Property="LabelText" Value="" />
        <Setter Property="BoxMode" Value="Outlined" />
        <!-- BoxCornerRadius property removed in DevExpress 25.1.3+ -->
        <!--<Setter Property="BoxCornerRadius" Value="4" />-->
        <Setter Property="FocusedBorderColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderColor" Value="{StaticResource Outline}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHighest}" />
        <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
    </Style>

    <!-- ================================================================ -->
    <!-- SHELL & NAVIGATION                                               -->
    <!-- ================================================================ -->

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource OnSurface}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource OnSurface}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource SurfaceContainer}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource OnSurfaceVariant}" />
    </Style>

    <!-- ================================================================ -->
    <!-- TYPOGRAPHY (MD3 Roboto)                                          -->
    <!-- ================================================================ -->

    <Style TargetType="Label" Class="Display.Large">
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="57" />
    </Style>

    <Style TargetType="Label" Class="Headline.Large">
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="32" />
    </Style>

    <Style TargetType="Label" Class="Title.Medium">
        <Setter Property="FontFamily" Value="RobotoMedium" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Label" Class="Body.Medium">
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" Class="Label.Large">
        <Setter Property="FontFamily" Value="RobotoMedium" />
        <Setter Property="FontSize" Value="14" />
    </Style>

</ResourceDictionary>