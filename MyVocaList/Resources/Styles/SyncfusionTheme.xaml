    <StaticResource x:Key="SfPopupNormalMessageBackground" Key="SurfaceContainerHigh" />
    <StaticResource x:Key="SfPopupNormalMessageTextColor" Key="OnSurfaceVariant" />
    <StaticResource x:Key="SfPopupNormalStroke" Key="SurfaceContainerHigh" />
    <StaticResource x:Key="SfShimmerFillColor" Key="SurfaceContainer" />
    <StaticResource x:Key="SfShimmerNormalBackground" Key="Surface" />
    <StaticResource x:Key="SfShimmerWaveColor" Key="SurfaceContainerHighest" />
    <StaticResource x:Key="SfTextInputLayoutCommonStroke" Key="Primary" />
    <StaticResource x:Key="SfTextInputLayoutErrorStroke" Key="Error" />
    <StaticResource x:Key="SfTextInputLayoutFocusedContainerBackground" Key="SurfaceContainerHighest" />
    <StaticResource x:Key="SfTextInputLayoutFocusedHintTextColor" Key="Primary" />
    <StaticResource x:Key="SfTextInputLayoutHelperTextColor" Key="OnSurfaceVariant" />
    <StaticResource x:Key="SfTextInputLayoutHintTextColor" Key="OnSurfaceVariant" />
    <StaticResource x:Key="SfTextInputLayoutHoveredStroke" Key="OnSurface" />
    <StaticResource x:Key="SfTextInputLayoutMouseHoveredContainerBackground" Key="SurfaceBright" />
    <StaticResource x:Key="SfTextInputLayoutNormalContainerBackground" Key="SurfaceContainerHighest" />
    <StaticResource x:Key="SfTextInputLayoutNormalErrorTextColor" Key="Error" />
    <StaticResource x:Key="SfTextInputLayoutPressedHintTextColor" Key="Primary" />
    <StaticResource x:Key="SfTextInputLayoutStroke" Key="Outline" />

</ResourceDictionary>
