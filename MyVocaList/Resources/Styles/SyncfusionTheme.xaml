    <StaticResource x:Key="SfEffectsViewRippleBackground" Key="OnSurface" />
    <StaticResource x:Key="SfEffectsViewSelectionBackground" Key="OnSurface" />
    <StaticResource x:Key="SfPopupFooterButtonRippleBackground" Key="OnSurface" />
