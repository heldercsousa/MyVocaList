<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Syncfusion Toolkit theme (T0.4a). Merges the Toolkit dark theme dictionary, then overrides keys with the Material tokens of
    MaterialColors.xaml (merge this file AFTER MaterialColors.xaml in App.xaml).
    Two layers: (1) common keys (PrimaryBackground, ContentForeground, ...) and (2) control-level keys (SfChipGroup*, SfTextInputLayout*,
    SfBottomSheet*, SfShimmer*, SfPopup*, SfButton*, SfEffectsView*). Controls read layer 2; the Toolkit resolves layer 1 into layer 2
    at load time, so layer 1 alone does not recolor controls and a Style setter cannot beat the control's dynamic theme resources.
    Not overridden on purpose: alpha state layers and *Disabled keys (no alpha token; Toolkit defaults are on-surface at 12%/38%),
    Overlay, Black/White, SeriesColor*, Segment*, Table*, *SearchResult and the control families the app does not use.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:themes="clr-namespace:Syncfusion.Maui.Toolkit.Themes;assembly=Syncfusion.Maui.Toolkit">


    <ResourceDictionary.MergedDictionaries>
        <themes:SyncfusionThemeResourceDictionary VisualTheme="MaterialDark" />
    </ResourceDictionary.MergedDictionaries>


    <!-- Primary -->
    <StaticResource x:Key="PrimaryBackground" Key="Primary" />
    <StaticResource x:Key="PrimaryBackgroundFocused" Key="Primary" />
    <StaticResource x:Key="PrimaryBackgroundHovered" Key="Primary" />
    <StaticResource x:Key="PrimaryBackgroundPressed" Key="Primary" />
    <StaticResource x:Key="PrimaryBackgroundSelected" Key="Primary" />
    <StaticResource x:Key="PrimaryBackgroundLight1" Key="OnPrimary" />
    <StaticResource x:Key="PrimaryBorder" Key="Primary" />
    <StaticResource x:Key="PrimaryBorderFocused" Key="Primary" />
    <StaticResource x:Key="PrimaryBorderHovered" Key="Primary" />
    <StaticResource x:Key="PrimaryBorderPressed" Key="Primary" />
    <StaticResource x:Key="PrimaryBorderSelected" Key="Primary" />
    <StaticResource x:Key="PrimaryForeground" Key="OnPrimary" />
    <StaticResource x:Key="PrimaryForegroundFocused" Key="OnPrimary" />
    <StaticResource x:Key="PrimaryForegroundHovered" Key="OnPrimary" />
    <StaticResource x:Key="PrimaryForegroundPressed" Key="OnPrimary" />
    <StaticResource x:Key="PrimaryForegroundSelected" Key="OnPrimary" />

    <!-- Secondary -->
    <StaticResource x:Key="SecondaryBackground" Key="SecondaryContainer" />
    <StaticResource x:Key="SecondaryBackgroundHovered" Key="SecondaryContainer" />
    <StaticResource x:Key="SecondaryBackgroundPressed" Key="SecondaryContainer" />
    <StaticResource x:Key="SecondaryBackgroundSelected" Key="SecondaryContainer" />
    <StaticResource x:Key="SecondaryBorder" Key="SecondaryContainer" />
    <StaticResource x:Key="SecondaryBorderHovered" Key="SecondaryContainer" />
    <StaticResource x:Key="SecondaryBorderPressed" Key="SecondaryContainer" />
    <StaticResource x:Key="SecondaryBorderSelected" Key="SecondaryContainer" />
    <StaticResource x:Key="SecondaryForeground" Key="OnSecondaryContainer" />
    <StaticResource x:Key="SecondaryForegroundHovered" Key="OnSecondaryContainer" />
    <StaticResource x:Key="SecondaryForegroundPressed" Key="OnSecondaryContainer" />
    <StaticResource x:Key="SecondaryForegroundSelected" Key="OnSecondaryContainer" />

    <!-- Content -->
    <StaticResource x:Key="ContentBackground" Key="Surface" />
    <StaticResource x:Key="ContentBackgroundAlt1" Key="SurfaceContainerLow" />
    <StaticResource x:Key="ContentBackgroundAlt2" Key="SurfaceContainer" />
    <StaticResource x:Key="ContentBackgroundAlt3" Key="SurfaceContainerHigh" />
    <StaticResource x:Key="ContentBackgroundAlt4" Key="SurfaceContainerHighest" />
    <StaticResource x:Key="ContentBackgroundAlt5" Key="SurfaceVariant" />
    <StaticResource x:Key="ContentBackgroundHovered" Key="SurfaceContainerHigh" />
    <StaticResource x:Key="ContentBackgroundFocused" Key="SurfaceContainerHighest" />
    <StaticResource x:Key="ContentBackgroundPressed" Key="SurfaceContainerHighest" />
    <StaticResource x:Key="ContentBackgroundSelected" Key="SecondaryContainer" />
    <StaticResource x:Key="ContentForeground" Key="OnSurface" />
    <StaticResource x:Key="ContentForegroundAlt1" Key="OnSurfaceVariant" />

    <!-- Border / outline -->
    <StaticResource x:Key="Border" Key="OutlineVariant" />
    <StaticResource x:Key="BorderAlt1" Key="Outline" />
    <StaticResource x:Key="BorderAlt2" Key="OnSurfaceVariant" />
    <StaticResource x:Key="BorderAlt4" Key="OnSurface" />

    <!-- Foreground states -->
    <StaticResource x:Key="ForegroundFocused" Key="OnSurface" />
    <StaticResource x:Key="ForegroundHovered" Key="OnSurface" />
    <StaticResource x:Key="ForegroundPressed" Key="OnSurface" />
    <StaticResource x:Key="ForegroundSelected" Key="OnSurface" />

    <!-- Error / status -->
    <StaticResource x:Key="ErrorBorder" Key="Error" />
    <StaticResource x:Key="ErrorForeground" Key="Error" />
    <StaticResource x:Key="InfoBackground" Key="Info" />
    <StaticResource x:Key="InfoBorder" Key="Info" />
    <StaticResource x:Key="InfoForeground" Key="Info" />
    <StaticResource x:Key="SuccessBorder" Key="Success" />
    <StaticResource x:Key="SuccessForeground" Key="Success" />
    <StaticResource x:Key="WarningBorder" Key="Warning" />
    <StaticResource x:Key="WarningForeground" Key="Warning" />

    <!-- Input -->
    <StaticResource x:Key="InputBackground" Key="SurfaceContainerHighest" />
    <StaticResource x:Key="InputBackgroundHovered" Key="SurfaceContainerHighest" />
    <StaticResource x:Key="InputBackgroundPressed" Key="SurfaceContainerHighest" />
    <StaticResource x:Key="InputBorderHovered" Key="OnSurface" />
    <StaticResource x:Key="InputBorderPressed" Key="Primary" />
    <StaticResource x:Key="InputBoxBorder" Key="Outline" />
    <StaticResource x:Key="PlaceholderForeground" Key="OnSurfaceVariant" />
    <StaticResource x:Key="TextSelectionFocused" Key="Primary" />
    <StaticResource x:Key="SliderThumbBackground" Key="Primary" />
    <StaticResource x:Key="SliderThumbBorder" Key="Primary" />

    <!-- Flyout -->
    <StaticResource x:Key="FlyoutBackground" Key="SurfaceContainerHigh" />
    <StaticResource x:Key="FlyoutBorder" Key="SurfaceContainerHigh" />
    <StaticResource x:Key="FlyoutBackgroundHovered" Key="SurfaceContainerHighest" />
