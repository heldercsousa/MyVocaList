    <!-- Chip active -->
    <StaticResource x:Key="ChipActiveBackground" Key="SecondaryContainer" />
    <StaticResource x:Key="ChipActiveBorder" Key="SecondaryContainer" />
    <StaticResource x:Key="ChipActiveForeground" Key="OnSecondaryContainer" />
    <StaticResource x:Key="ChipActiveFocusedBackground" Key="SecondaryContainer" />
    <StaticResource x:Key="ChipActiveFocusedBorder" Key="SecondaryContainer" />
    <StaticResource x:Key="ChipActiveFocusedForeground" Key="OnSecondaryContainer" />
    <StaticResource x:Key="ChipActiveHoveredBackground" Key="SecondaryContainer" />
    <StaticResource x:Key="ChipActiveHoveredBorder" Key="SecondaryContainer" />
    <StaticResource x:Key="ChipActiveHoveredForeground" Key="OnSecondaryContainer" />
    <StaticResource x:Key="ChipActivePressedBackground" Key="SecondaryContainer" />
    <StaticResource x:Key="ChipActivePressedBorder" Key="SecondaryContainer" />
    <StaticResource x:Key="ChipActivePressedForeground" Key="OnSecondaryContainer" />

    <!-- Chip inactive -->
    <StaticResource x:Key="ChipInactiveBackground" Key="Surface" />
    <StaticResource x:Key="ChipInactiveBorder" Key="Outline" />
    <StaticResource x:Key="ChipInactiveForeground" Key="OnSurfaceVariant" />
    <StaticResource x:Key="ChipInactiveFocusedBackground" Key="SurfaceContainerHigh" />
    <StaticResource x:Key="ChipInactiveFocusedBorder" Key="Outline" />
    <StaticResource x:Key="ChipInactiveFocusedForeground" Key="OnSurfaceVariant" />
    <StaticResource x:Key="ChipInactiveHoveredBackground" Key="SurfaceContainerHigh" />
    <StaticResource x:Key="ChipInactiveHoveredBorder" Key="Outline" />
    <StaticResource x:Key="ChipInactiveHoveredForeground" Key="OnSurfaceVariant" />
    <StaticResource x:Key="ChipInactivePressedBackground" Key="SurfaceContainerHigh" />
    <StaticResource x:Key="ChipInactivePressedBorder" Key="Outline" />
    <StaticResource x:Key="ChipInactivePressedForeground" Key="OnSurfaceVariant" />

    <!-- Toast / tooltip -->
    <StaticResource x:Key="ToastBackground" Key="InverseSurface" />
    <StaticResource x:Key="ToastForeground" Key="InverseOnSurface" />
    <StaticResource x:Key="TooltipBackground" Key="InverseSurface" />
    <StaticResource x:Key="TooltipBorder" Key="InverseSurface" />
    <StaticResource x:Key="TooltipContentBorder" Key="InverseSurface" />
    <StaticResource x:Key="TooltipForeground" Key="InverseOnSurface" />

    <!-- Shimmer -->
    <StaticResource x:Key="ShimmerWaveColor" Key="SurfaceBright" />

    <!-- Toolkit control-level keys (DefaultTheme): controls read these, not the common keys above. Opaque defaults only; alpha state layers keep the Toolkit default. -->
    <StaticResource x:Key="SfBottomSheetBackground" Key="SurfaceContainer" />
    <StaticResource x:Key="SfBottomSheetGrabberBackground" Key="OutlineVariant" />
    <StaticResource x:Key="SfButtonFocusedBackground" Key="Primary" />
    <StaticResource x:Key="SfButtonFocusedStroke" Key="OnSurface" />
    <StaticResource x:Key="SfButtonFocusedTextColor" Key="OnPrimary" />
    <StaticResource x:Key="SfButtonHoverBackground" Key="Primary" />
    <StaticResource x:Key="SfButtonHoverStroke" Key="Primary" />
    <StaticResource x:Key="SfButtonHoverTextColor" Key="OnPrimary" />
    <StaticResource x:Key="SfButtonNormalBackground" Key="Primary" />
    <StaticResource x:Key="SfButtonNormalStroke" Key="Primary" />
    <StaticResource x:Key="SfButtonNormalTextColor" Key="OnPrimary" />
    <StaticResource x:Key="SfButtonPressedBackground" Key="Primary" />
    <StaticResource x:Key="SfButtonPressedStroke" Key="Primary" />
    <StaticResource x:Key="SfButtonPressedTextColor" Key="OnPrimary" />
    <StaticResource x:Key="SfChipGroupChoiceBackground" Key="SurfaceContainer" />
    <StaticResource x:Key="SfChipGroupDisabledSelectedTextColor" Key="OnSurface" />
    <StaticResource x:Key="SfChipGroupDisabledSelectionBackground" Key="SecondaryContainer" />
    <StaticResource x:Key="SfChipGroupHoverClearButtonIconColor" Key="OnSurface" />
    <StaticResource x:Key="SfChipGroupHoverSelectedTextColor" Key="OnSecondaryContainer" />
    <StaticResource x:Key="SfChipGroupHoverSelectionBackground" Key="SecondaryContainer" />
    <StaticResource x:Key="SfChipGroupHoverStroke" Key="Outline" />
    <StaticResource x:Key="SfChipGroupHoverTextColor" Key="OnSurfaceVariant" />
    <StaticResource x:Key="SfChipGroupNormalClearButtonIconColor" Key="OnSurfaceVariant" />
    <StaticResource x:Key="SfChipGroupNormalSelectedTextColor" Key="OnSecondaryContainer" />
    <StaticResource x:Key="SfChipGroupNormalSelectionBackground" Key="SecondaryContainer" />
    <StaticResource x:Key="SfChipGroupNormalSelectionIndicatorColor" Key="OnSecondaryContainer" />
    <StaticResource x:Key="SfChipGroupNormalStroke" Key="Outline" />
