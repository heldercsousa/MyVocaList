<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:local="clr-namespace:MyVocaList"
             x:Class="MyVocaList.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary x:Name="appColors" Source="Resources/Styles/MaterialColors.xaml" />
                <ResourceDictionary x:Name="appStyles" Source="Resources/Styles/MaterialStyles.xaml" />
                <material:StyleResource ColorsOverride="{x:Reference appColors}" BasedOn="{x:Reference appStyles}" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Typography Fallback (fixes StyleClass bug) -->
            <Style x:Key="HeadlineLarge" TargetType="Label">
                <Setter Property="FontSize" Value="48" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="HeadlineMedium" TargetType="Label">
                <Setter Property="FontSize" Value="36" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="TitleLarge" TargetType="Label">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="TitleMedium" TargetType="Label">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="BodyMedium" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
            </Style>
            <Style x:Key="LabelLarge" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
            </Style>
            <Style x:Key="LabelSmall" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>