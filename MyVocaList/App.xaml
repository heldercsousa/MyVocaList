<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MyVocaList.UI.Converters"
             xmlns:migration="clr-namespace:MyVocaList.UI.Migration"
             x:Class="MyVocaList.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:IsNotZeroConverter x:Key="IsNotZeroConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:SecondsToMinutesConverter x:Key="SecondsToMinutesConverter" />
            <converters:ImageReferenceConverter x:Key="ImageReferenceConverter" />
            <migration:DxSheetStateConverter x:Key="DxSheetStateToSf" />
            <migration:DxSheetStateToIsOpenConverter x:Key="DxSheetStateToSfIsOpen" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/MaterialColors.xaml" />
                <ResourceDictionary Source="Resources/Styles/MaterialStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/SyncfusionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>