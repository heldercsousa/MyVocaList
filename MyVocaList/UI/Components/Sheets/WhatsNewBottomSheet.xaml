<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MyVocaList.UI.Components.Sheets.WhatsNewBottomSheet"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui">

    <dx:BottomSheet
        x:Name="Sheet"
        AllowDismiss="True"
        HalfExpandedRatio="0.6">

        <dx:BottomSheet.Content>
            <ScrollView>
                <VerticalStackLayout Padding="24,16,24,32" Spacing="0">

                    <Label
                        x:Name="TitleLabel"
                        StyleClass="Title.Large"
                        Margin="0,0,0,4" />

                    <Label
                        x:Name="DateLabel"
                        StyleClass="Body.Small"
                        TextColor="{StaticResource OnSurfaceVariant}"
                        Margin="0,0,0,24" />

                    <Label
                        x:Name="HighlightsTitleLabel"
                        Text="What's New"
                        StyleClass="Title.Medium"
                        Margin="0,0,0,8" />

                    <VerticalStackLayout
                        x:Name="HighlightsList"
                        Spacing="6"
                        Margin="0,0,0,16" />

                    <Label
                        x:Name="FixesTitleLabel"
                        Text="Bug Fixes"
                        StyleClass="Title.Medium"
                        Margin="0,0,0,8" />

                    <VerticalStackLayout
                        x:Name="FixesList"
                        Spacing="6"
                        Margin="0,0,0,24" />

                    <dx:DXButton
                        Content="Got it"
                        ButtonType="Filled"
                        HorizontalOptions="Fill"
                        Clicked="OnGotItClicked" />

                </VerticalStackLayout>
            </ScrollView>
        </dx:BottomSheet.Content>
    </dx:BottomSheet>
</ContentView>
