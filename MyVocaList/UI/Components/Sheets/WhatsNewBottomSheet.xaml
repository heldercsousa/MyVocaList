<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MyVocaList.UI.Components.Sheets.WhatsNewBottomSheet"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bottomsheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit">

    <bottomsheet:SfBottomSheet
        x:Name="Sheet"
        AllowedState="All"
        HalfExpandedRatio="0.6"
        ContentPadding="0"
        IsModal="True"
        ShowGrabber="True"
        CornerRadius="28,28,0,0">

        <bottomsheet:SfBottomSheet.Background>
            <SolidColorBrush Color="{StaticResource Surface}" />
        </bottomsheet:SfBottomSheet.Background>

        <bottomsheet:SfBottomSheet.BottomSheetContent>
            <ScrollView>
                <VerticalStackLayout Padding="24,16,24,32" Spacing="0">

                    <Label
                        x:Name="TitleLabel"
                        StyleClass="Title.Large"
                        TextColor="{StaticResource OnSurface}"
                        Margin="0,0,0,4" />

                    <Label
                        x:Name="DateLabel"
                        StyleClass="Body.Small"
                        TextColor="{StaticResource OnSurfaceVariant}"
                        Margin="0,0,0,24" />

                    <Label
                        x:Name="HighlightsTitleLabel"
                        Text="What's New"
                        StyleClass="Title.Medium"
                        Margin="0,0,0,8" />

                    <VerticalStackLayout
                        x:Name="HighlightsList"
                        Spacing="6"
                        Margin="0,0,0,16" />

                    <Label
                        x:Name="FixesTitleLabel"
                        Text="Bug Fixes"
                        StyleClass="Title.Medium"
                        Margin="0,0,0,8" />

                    <VerticalStackLayout
                        x:Name="FixesList"
                        Spacing="6"
                        Margin="0,0,0,24" />

                    <buttons:SfButton
                        Text="Got it"
                        Style="{StaticResource SfFilledButton}"
                        HorizontalOptions="Fill"
                        Clicked="OnGotItClicked" />

                </VerticalStackLayout>
            </ScrollView>
        </bottomsheet:SfBottomSheet.BottomSheetContent>
    </bottomsheet:SfBottomSheet>
</ContentView>
