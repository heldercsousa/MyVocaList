<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:pages="clr-namespace:MyVocaList.UI.Pages.Base"
    x:Class="MyVocaList.UI.Components.Lists.ListItemOverflowButton">

    <dx:DXButton
        Style="{StaticResource StandardIconButton}"
        Icon="more_vert_outlined"
        WidthRequest="48"
        HeightRequest="48"
        SemanticProperties.Description="More options"
        InputTransparent="False"
        IsVisible="{Binding BindingContext.IsSelectionMode, Source={RelativeSource AncestorType={x:Type pages:CrudListPageBase}}, Converter={StaticResource InverseBoolConverter}}"
        Clicked="OnClicked" />
</ContentView>
