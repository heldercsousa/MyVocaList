<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    x:Class="MyVocaList.UI.Components.Lists.ListItemLeadingImage"
    x:Name="self">

    <Border
        StrokeShape="RoundRectangle 4"
        Stroke="Transparent"
        WidthRequest="56"
        HeightRequest="56">

        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding PlaceholderIcon, Source={x:Reference self}, Converter={StaticResource IsNotNullConverter}}"
                         Value="True">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHighest}" />
            </DataTrigger>
        </Border.Triggers>

        <!-- Placeholder icon sits under the image: a loaded image covers it, a missing or failed one leaves it visible. -->
        <Grid>
            <dx:DXImage
                Source="{Binding PlaceholderIcon, Source={x:Reference self}}"
                IsVisible="{Binding PlaceholderIcon, Source={x:Reference self}, Converter={StaticResource IsNotNullConverter}}"
                TintColor="{StaticResource OnSurfaceVariant}"
                WidthRequest="24"
                HeightRequest="24"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Image
                Source="{Binding ImageSource, Source={x:Reference self}}"
                Aspect="{Binding Aspect, Source={x:Reference self}}"
                WidthRequest="56"
                HeightRequest="56" />
        </Grid>

    </Border>
</ContentView>
