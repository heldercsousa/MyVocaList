<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:MyVocaList.UI.Behaviors"
    x:Class="MyVocaList.UI.Components.Lists.ListItemLeadingAvatar"
    x:Name="self">

    <!-- Stock Border clips its children to the rounded shape. -->
    <Border
        StrokeShape="Ellipse"
        Stroke="Transparent"
        BackgroundColor="{StaticResource SurfaceContainerHighest}"
        WidthRequest="40"
        HeightRequest="40">

        <!-- Placeholder icon sits under the image: a loaded image covers it, a missing or failed one leaves it visible. -->
        <Grid>
            <Image
                Source="{Binding PlaceholderIcon, Source={x:Reference self}}"
                behaviors:IconTint.Color="{StaticResource OnSurfaceVariant}"
                WidthRequest="24"
                HeightRequest="24"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Image
                Source="{Binding ImageSource, Source={x:Reference self}}"
                Aspect="AspectFill"
                WidthRequest="40"
                HeightRequest="40" />
        </Grid>

    </Border>
</ContentView>
