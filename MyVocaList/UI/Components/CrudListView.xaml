<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
    xmlns:appbars="clr-namespace:MyVocaList.UI.Components.AppBars"
    xmlns:toolbars="clr-namespace:MyVocaList.UI.Components.Toolbars"
    xmlns:states="clr-namespace:MyVocaList.UI.Components.States"
    x:Class="MyVocaList.UI.Components.CrudListView"
    x:Name="self">

    <!-- Root Grid: Row 0 (Auto) = persistent SearchBar; Row 1 (Auto) = optional FilterContent slot;
         Row 2 (*) = list + overlays -->
    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="filterRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: persistent MD3 Search bar (standalone/docked) — REQ-SEARCHBAR-01/09 -->
        <appbars:SearchBar x:Name="searchBar"
                           Grid.Row="0"
                           SearchText="{Binding SearchText, Source={x:Reference self}, Mode=TwoWay}"
                           Placeholder="{Binding SearchPlaceholder, Source={x:Reference self}}"
                           IsElevated="{Binding IsSearchBarElevated, Source={x:Reference self}}" />

        <!-- Row 1: FilterContent slot — Content + visibility assigned in code-behind OnFilterContentChanged.
             A ContentView host (not ContentPresenter) is used because ContentPresenter only renders its
             content inside a ControlTemplate; placed directly in a layout it shows nothing. -->
        <ContentView x:Name="filterContentHost"
                     Grid.Row="1"
                     IsVisible="False" />

        <!-- Row 2: ShimmerView wrapping DXCollectionView -->
        <dx:ShimmerView Grid.Row="2"
                        IsLoading="{Binding IsInitialLoading}"
                        WaveWidth="0.7"
                        WaveOpacity="0.8">
            <dx:ShimmerView.LoadingView>
                <VerticalStackLayout Spacing="0">
                    <dx:DXBorder Style="{StaticResource SkeletonBone}" />
                    <dx:DXBorder Style="{StaticResource SkeletonBone}" />
                    <dx:DXBorder Style="{StaticResource SkeletonBone}" />
                    <dx:DXBorder Style="{StaticResource SkeletonBone}" />
                    <dx:DXBorder Style="{StaticResource SkeletonBone}" />
                    <dx:DXBorder Style="{StaticResource SkeletonBone}" />
                </VerticalStackLayout>
            </dx:ShimmerView.LoadingView>
            <dx:ShimmerView.Content>
                <dxcv:DXCollectionView x:Name="collectionView"
                       ItemsSource="{Binding ItemsSource, Source={x:Reference self}}"
                       IsPullToRefreshEnabled="True"
                       IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                       PullToRefreshCommand="{Binding RefreshCommand}"
                       IsLoadMoreEnabled="{Binding HasMoreItems}"
                       LoadMoreCommand="{Binding LoadMoreCommand}"
                       IndicatorColor="{StaticResource Primary}"
                       SelectionMode="Multiple"
                       UseRippleEffect="True"
                       ItemSeparatorThickness="0"
                       Margin="0,0,0,88"
                       ItemTemplate="{Binding ItemTemplate, Source={x:Reference self}}"
                       SelectedItemTemplate="{Binding SelectedItemTemplate, Source={x:Reference self}}"
                       Scrolled="OnCollectionViewScrolled"
                       SelectionChanged="OnSelectionChanged" />
            </dx:ShimmerView.Content>
        </dx:ShimmerView>

        <!-- Empty state: no items of this entity type registered -->
        <states:EmptyState Grid.Row="2"
            Illustration="{Binding EmptyNoItemsIllustration, Source={x:Reference self}}"
            Headline="{Binding EmptyNoItemsHeadline, Source={x:Reference self}}"
            IsVisible="{Binding IsEmptyNoItems, Source={x:Reference self}}"
            Margin="32,32,32,88" />

        <!-- Empty state: search returned no results — bound directly via ICrudListViewModel BindingContext -->
        <states:EmptyState Grid.Row="2"
            Illustration="search_outlined"
            Headline="No results found"
            IsVisible="{Binding IsEmptyNoResults}"
            Margin="32,32,32,88" />

        <!-- Toolbar + FAB: centered row, 16dp from bottom -->
        <HorizontalStackLayout Grid.Row="2"
                               HorizontalOptions="Center"
                               VerticalOptions="End"
                               Margin="0,0,0,16"
                               Spacing="8">
            <toolbars:FloatingToolbar
                VerticalOptions="Center"
                Action1Icon="done_all_outlined"
                Action1Command="{Binding SelectAllCommand}"
                Action1Description="Select all"
                Action1IsSelected="{Binding IsAllSelected}"
                Action2Icon="edit_outlined"
                Action2Command="{Binding EditSelectedCommand}"
                Action2Description="Edit selected"
                Action2IsSelected="{Binding CanEditSelected}"
                Action3Icon="delete_outlined"
                Action3Command="{Binding DeleteSelectedCommand}"
                Action3Description="Delete selected"
                Action3IsSelected="{Binding CanDeleteSelected}" />
            <dx:DXButton Style="{StaticResource Fab}"
                         Icon="{Binding FabIcon, Source={x:Reference self}}"
                         VerticalOptions="Center"
                         SemanticProperties.Description="{Binding FabDescription, Source={x:Reference self}}"
                         Command="{Binding FabCommand, Source={x:Reference self}}" />
        </HorizontalStackLayout>

        <!-- Confirm action BottomSheet — state driven by ICrudListViewModel.ConfirmSheetState -->
        <dx:BottomSheet x:Name="confirmSheet"
                        Grid.Row="2"
                        HalfExpandedRatio="0.28"
                        AllowedState="HalfExpanded"
                        IsModal="True"
                        ShowGrabber="True"
                        AllowDismiss="True"
                        BackgroundColor="{StaticResource Surface}"
                        CornerRadius="28"
                        StateChanged="OnConfirmSheetStateChanged">
            <VerticalStackLayout>
                <Label Text="{Binding ConfirmMessage}"
                       StyleClass="Title.Medium"
                       TextColor="{StaticResource OnSurface}"
                       HorizontalTextAlignment="Center"
                       Margin="24,20" />
                <BoxView Style="{StaticResource Divider}" />
                <dx:DXButton Content="{Binding ConfirmActionText}"
                             Style="{StaticResource BottomSheetDestructiveAction}"
                             Command="{Binding ConfirmActionCommand}" />
                <BoxView Style="{StaticResource Divider}" />
                <dx:DXButton Content="Cancel"
                             Style="{StaticResource BottomSheetCancelAction}"
                             Command="{Binding DismissConfirmCommand}" />
            </VerticalStackLayout>
        </dx:BottomSheet>

    </Grid>

</ContentView>
