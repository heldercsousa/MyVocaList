<?xml version="1.0" encoding="utf-8" ?>
<appbars:AppBarBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:appbars="clr-namespace:MyVocaList.UI.Components.AppBars"
    xmlns:behaviors="clr-namespace:MyVocaList.UI.Behaviors"
    xmlns:textfields="clr-namespace:MyVocaList.UI.Components.TextFields"
    x:Class="MyVocaList.UI.Components.AppBars.SearchBarSf"
    x:Name="self">

    <!-- MD3 Search bar (standalone/docked): 56dp pill, SurfaceContainerLow;
         IsElevated (liftOnScroll) -> SurfaceContainer via UpdateContainerColor. -->
    <Border x:Name="container"
            HeightRequest="56"
            Margin="16,8"
            Padding="0"
            StrokeThickness="0"
            BackgroundColor="{StaticResource SurfaceContainerLow}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="28" />
        </Border.StrokeShape>

        <!-- Leading search_outlined icon is non-interactive (plain Image, no button).
             Search input: OutlinedTextFieldSf (SfTextInputLayout fails here, design § Control mapping),
             trailing auto clear icon = ClearButtonVisibility WhileEditing.
             No back arrow, no BackCommand, no auto-focus (REQ-SEARCHBAR-03). -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="0" VerticalOptions="Center">
            <Image Grid.Column="0"
                   Source="search_outlined"
                   WidthRequest="24"
                   HeightRequest="24"
                   Margin="20,0,0,0"
                   VerticalOptions="Center"
                   behaviors:IconTint.Color="{StaticResource OnSurfaceVariant}"
                   AutomationProperties.IsInAccessibleTree="False" />
            <textfields:OutlinedTextFieldSf x:Name="searchEdit"
                                            Grid.Column="1"
                                            Text="{Binding SearchText, Source={x:Reference self}, Mode=TwoWay}"
                                            Placeholder="{Binding Placeholder, Source={x:Reference self}}"
                                            ClearButtonVisibility="WhileEditing"
                                            Keyboard="Text"
                                            ReturnType="Search"
                                            ShowOutline="False"
                                            VerticalOptions="Center"
                                            Margin="-4,0,0,0"
                                            SemanticProperties.Description="{Binding Placeholder, Source={x:Reference self}}" />
        </Grid>
    </Border>
</appbars:AppBarBase>
