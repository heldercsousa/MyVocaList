<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.syncfusion.com/maui/toolkit"
    x:Class="MyVocaList.UI.Components.AppBars.SearchBarSf"
    x:Name="self">

    <!-- SPIKE (task/spike-syncfusion): Syncfusion copy of appbars:SearchBar.
         Same BindableProperties (SearchText TwoWay, Placeholder). Elevation (IsElevated) is not ported:
         the copy keeps SurfaceContainerLow. Input is a plain MAUI Entry (S5b fallback): SfTextInputLayout
         never measured its hosted Entry on Android (Width/Height -1, no EditText in the native tree). -->
    <Border x:Name="container"
            StrokeShape="RoundRectangle 28"
            HeightRequest="56"
            Margin="16,8"
            Stroke="Transparent"
            BackgroundColor="{StaticResource SurfaceContainerLow}">

        <Entry x:Name="searchEntry"
               Text="{Binding SearchText, Source={x:Reference self}, Mode=TwoWay}"
               Placeholder="{Binding Placeholder, Source={x:Reference self}}"
               PlaceholderColor="{StaticResource OnSurfaceVariant}"
               TextColor="{StaticResource OnSurface}"
               BackgroundColor="Transparent"
               FontSize="16"
               Margin="24,0,16,0"
               VerticalOptions="Center"
               Keyboard="Text"
               ReturnType="Search"
               ClearButtonVisibility="WhileEditing"
               SemanticProperties.Description="{Binding Placeholder, Source={x:Reference self}}" />
    </Border>
</ContentView>
