<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MyVocaList.UI.Components.Menus.OverflowMenuButtonSf"
    x:Name="self">

    <!-- MD3 standard icon button (action/trailing role) that opens a MenuSf. The menu is resolved on tap: explicit Menu,
         else the nearest ancestor IMenuHostSf (REQ-OVFM-20). Pressed state lives in code-behind (REQ-OVFM-22). -->
    <ImageButton x:Name="button"
                 Style="{StaticResource SfIconButton}"
                 Source="more_vert_outlined"
                 SemanticProperties.Description="{Binding Description, Source={x:Reference self}}"
                 InputTransparent="False"
                 Clicked="OnClicked" />
</ContentView>
