<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:MyVocaList.UI.Behaviors"
    x:Class="MyVocaList.UI.Components.Toolbars.FloatingToolbarSf"
    x:Name="self">

    <!--
        M3 Floating Toolbar — pill container with up to 5 icon-only action slots.
        Height: 64dp · Shape: CornerRadius=32 (pill) · Background: SecondaryContainer (vibrant)
        Icon color: OnSecondaryContainer (default) · Selected: Primary bg + OnPrimary icon
        Padding: 8dp left/right · Slot spacing: 4dp · Slots with null/empty ActionNIcon are hidden.
    -->
    <Border HeightRequest="64"
            BackgroundColor="{StaticResource SecondaryContainer}"
            StrokeThickness="0"
            Padding="8,0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="32" />
        </Border.StrokeShape>

        <!--
            Dark mode: elevation is expressed via SurfaceContainerHigh color tint, not shadow.
            Shadow is invisible against near-black backgrounds — intentionally omitted.
        -->
        <HorizontalStackLayout Spacing="4">

            <!-- Slot 1 -->
            <ImageButton x:Name="action1Button"
                         Source="{Binding Action1Icon, Source={x:Reference self}}"
                         Style="{StaticResource SfIconButton}"
                         behaviors:IconTint.Color="{StaticResource OnSecondaryContainer}"
                         VerticalOptions="Center"
                         IsVisible="{Binding HasAction1, Source={x:Reference self}}"
                         SemanticProperties.Description="{Binding Action1Description, Source={x:Reference self}}"
                         Command="{Binding Action1Command, Source={x:Reference self}}" />

            <!-- Slot 2 -->
            <ImageButton x:Name="action2Button"
                         Source="{Binding Action2Icon, Source={x:Reference self}}"
                         Style="{StaticResource SfIconButton}"
                         behaviors:IconTint.Color="{StaticResource OnSecondaryContainer}"
                         VerticalOptions="Center"
                         IsVisible="{Binding HasAction2, Source={x:Reference self}}"
                         SemanticProperties.Description="{Binding Action2Description, Source={x:Reference self}}"
                         Command="{Binding Action2Command, Source={x:Reference self}}" />

            <!-- Slot 3 -->
            <ImageButton x:Name="action3Button"
                         Source="{Binding Action3Icon, Source={x:Reference self}}"
                         Style="{StaticResource SfIconButton}"
                         behaviors:IconTint.Color="{StaticResource OnSecondaryContainer}"
                         VerticalOptions="Center"
                         IsVisible="{Binding HasAction3, Source={x:Reference self}}"
                         SemanticProperties.Description="{Binding Action3Description, Source={x:Reference self}}"
                         Command="{Binding Action3Command, Source={x:Reference self}}" />

            <!-- Slot 4 -->
            <ImageButton x:Name="action4Button"
                         Source="{Binding Action4Icon, Source={x:Reference self}}"
                         Style="{StaticResource SfIconButton}"
                         behaviors:IconTint.Color="{StaticResource OnSecondaryContainer}"
                         VerticalOptions="Center"
                         IsVisible="{Binding HasAction4, Source={x:Reference self}}"
                         SemanticProperties.Description="{Binding Action4Description, Source={x:Reference self}}"
                         Command="{Binding Action4Command, Source={x:Reference self}}" />

            <!-- Slot 5 -->
            <ImageButton x:Name="action5Button"
                         Source="{Binding Action5Icon, Source={x:Reference self}}"
                         Style="{StaticResource SfIconButton}"
                         behaviors:IconTint.Color="{StaticResource OnSecondaryContainer}"
                         VerticalOptions="Center"
                         IsVisible="{Binding HasAction5, Source={x:Reference self}}"
                         SemanticProperties.Description="{Binding Action5Description, Source={x:Reference self}}"
                         Command="{Binding Action5Command, Source={x:Reference self}}" />

        </HorizontalStackLayout>
    </Border>
</ContentView>
