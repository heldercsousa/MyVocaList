<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MyVocaList.UI.Pages.Venues.VenueMapPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:inputlayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:lists="clr-namespace:MyVocaList.UI.Components.Lists"
    xmlns:venues="clr-namespace:MyVocaList.Contracts.DTOs.Venues;assembly=MyVocaList.Contracts"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    x:DataType="vm:VenueMapPickerViewModel"
    Title="Pick the venue location"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Search: runs on submit only (REQ-VEN-25), never per keystroke -->
        <inputlayout:SfTextInputLayout Grid.Row="0"
                                       Hint="{Binding SearchPlaceholder}"
                                       ContainerType="Outlined"
                                       ReserveSpaceForAssistiveLabels="False"
                                       Margin="16,8">
            <Entry Text="{Binding SearchText, Mode=TwoWay}"
                   TextColor="{StaticResource OnSurface}"
                   ReturnType="Search"
                   ClearButtonVisibility="WhileEditing"
                   ReturnCommand="{Binding SearchCommand}" />
            <inputlayout:SfTextInputLayout.TrailingView>
                <ImageButton Source="search_outlined"
                             Style="{StaticResource SfIconButton}"
                             Command="{Binding SearchCommand}" />
            </inputlayout:SfTextInputLayout.TrailingView>
        </inputlayout:SfTextInputLayout>

        <!-- Results list: visible while there are results -->
        <!-- BindableLayout, not DXCollectionView: a tap recognizer inside a DXCollectionView row does not fire (emulator check). -->
        <ScrollView Grid.Row="1"
                    IsVisible="{Binding HasResults}"
                    MaximumHeightRequest="240">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="venues:VenuePlace">
                        <VerticalStackLayout Padding="16,12" Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VenueMapPickerViewModel}}, Path=SelectResultCommand, x:DataType=vm:VenueMapPickerViewModel}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Name}"
                                   StyleClass="Body.Large"
                                   TextColor="{StaticResource OnSurface}"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding AddressLine}"
                                   StyleClass="Body.Small"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="1"
               Text="No place found."
               IsVisible="{Binding HasNoResults}"
               StyleClass="Body.Small"
               Margin="16,8" />

        <!-- Map area: web map, or the offline text when there is no internet -->
        <Grid Grid.Row="2">
            <HybridWebView x:Name="mapView"
                           HybridRoot="venuemap"
                           DefaultFile="index.html"
                           IsVisible="{Binding IsOffline, Converter={StaticResource InverseBoolConverter}}" />

            <Label Text="{Binding OfflineText}"
                   IsVisible="{Binding IsOffline}"
                   StyleClass="Body.Small"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="24" />

            <ActivityIndicator IsRunning="{Binding IsSearching}"
                               IsVisible="{Binding IsSearching}"
                               HorizontalOptions="Center"
                               VerticalOptions="Start"
                               Margin="0,8" />

            <ActivityIndicator IsRunning="{Binding IsLookingUp}"
                               IsVisible="{Binding IsLookingUp}"
                               HorizontalOptions="Center"
                               VerticalOptions="Start"
                               Margin="0,8" />
        </Grid>

        <!-- Bottom panel: the selected place or point, with the confirm action -->
        <Border Grid.Row="3"
                IsVisible="{Binding IsPanelVisible}"
                BackgroundColor="{StaticResource SurfaceContainerLow}"
                Padding="16">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding PanelTitle}" StyleClass="Title.Medium" />
                <Label Text="{Binding PanelText}" StyleClass="Body.Small" />
                <buttons:SfButton Text="{Binding ConfirmText}"
                                  Command="{Binding ConfirmCommand}"
                                  Style="{StaticResource SfFilledButton}"
                                  HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
