<?xml version="1.0" encoding="utf-8" ?>
<pages:CrudListPageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bottomsheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:dto="clr-namespace:MyVocaList.Contracts.DTOs.List;assembly=MyVocaList.Contracts"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    xmlns:pages="clr-namespace:MyVocaList.UI.Pages.Base"
    xmlns:appbars="clr-namespace:MyVocaList.UI.Components.AppBars"
    xmlns:lists="clr-namespace:MyVocaList.UI.Components.Lists"
    xmlns:views="clr-namespace:MyVocaList.UI.Components"
    x:Class="MyVocaList.UI.Pages.Venues.VenuesSfPage"
    x:Name="page"
    x:DataType="vm:VenuesViewModel"
    Title="Venues"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="Container">

    <pages:CrudListPageBase.Resources>
        <!-- Exit sheet actions: same look as the CrudListViewSf sheet actions (full width, 56dp). -->
        <Style x:Key="SfExitSheetDestructiveAction" TargetType="buttons:SfButton" BasedOn="{StaticResource SfTextButton}">
            <Setter Property="TextColor" Value="{StaticResource Error}" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="SfExitSheetCancelAction" TargetType="buttons:SfButton" BasedOn="{StaticResource SfTextButton}">
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </pages:CrudListPageBase.Resources>

    <Shell.TitleView>
        <appbars:SmallAppBarSf
            Title="{Binding AppBarTitle}"
            IsElevated="{Binding IsScrolled}" />
    </Shell.TitleView>

    <!-- Exit confirmation: the sheet hosts the whole list in Content so its overlay covers the page. -->
    <bottomsheet:SfBottomSheet x:Name="exitConfirmSheet"
                               AllowedState="HalfExpanded"
                               HalfExpandedRatio="0.32"
                               ContentPadding="0"
                               IsModal="True"
                               ShowGrabber="True"
                               CornerRadius="28,28,0,0">
        <bottomsheet:SfBottomSheet.Background>
            <SolidColorBrush Color="{StaticResource Surface}" />
        </bottomsheet:SfBottomSheet.Background>
        <bottomsheet:SfBottomSheet.BottomSheetContent>
            <VerticalStackLayout>
                <Label Text="Exit MyVocaList?"
                       StyleClass="Title.Medium"
                       TextColor="{StaticResource OnSurface}"
                       HorizontalTextAlignment="Center"
                       Margin="24,20" />
                <BoxView Style="{StaticResource Divider}" />
                <buttons:SfButton Text="Exit"
                                  Style="{StaticResource SfExitSheetDestructiveAction}"
                                  Clicked="OnConfirmExit" />
                <BoxView Style="{StaticResource Divider}" />
                <buttons:SfButton Text="Cancel"
                                  Style="{StaticResource SfExitSheetCancelAction}"
                                  Clicked="OnCancelExit" />
            </VerticalStackLayout>
        </bottomsheet:SfBottomSheet.BottomSheetContent>
        <bottomsheet:SfBottomSheet.Content>
            <views:CrudListViewSf
                ItemsSource="{Binding Venues}"
                SelectedItemsSource="{Binding SelectedVenuesRaw}"
                IsEmptyNoItems="{Binding IsEmptyNoVenues}"
                SearchText="{Binding SearchText, Mode=TwoWay}"
                IsSearchBarElevated="{Binding IsScrolled}"
                SearchPlaceholder="Search venues..."
                EmptyNoItemsIllustration="nightlife_outlined"
                EmptyNoItemsHeadline="No venue registered"
                FabCommand="{Binding AddVenueCommand}"
                FabDescription="Add venue">

                <views:CrudListViewSf.ItemTemplate>
                    <DataTemplate x:DataType="dto:VenueListItemDto">
                        <lists:ListItem Headline="{Binding Name}"
                                        SupportingText="{Binding AddressSummary}"
                                        IsSelected="False">
                            <lists:ListItem.LeadingContent>
                                <lists:ListItemLeadingImage ImageSource="{Binding ImageUrl, Converter={StaticResource ImageReferenceConverter}}" PlaceholderIcon="nightlife_outlined" Margin="0,8" />
                            </lists:ListItem.LeadingContent>
                            <lists:ListItem.TrailingContent>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <lists:ListItemOverflowButtonSf />
                                    <lists:ListItemCheckbox VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </lists:ListItem.TrailingContent>
                        </lists:ListItem>
                    </DataTemplate>
                </views:CrudListViewSf.ItemTemplate>

                <views:CrudListViewSf.SelectedItemTemplate>
                    <DataTemplate x:DataType="dto:VenueListItemDto">
                        <lists:ListItem Headline="{Binding Name}"
                                        SupportingText="{Binding AddressSummary}"
                                        IsSelected="True">
                            <lists:ListItem.LeadingContent>
                                <lists:ListItemLeadingImage ImageSource="{Binding ImageUrl, Converter={StaticResource ImageReferenceConverter}}" PlaceholderIcon="nightlife_outlined" Margin="0,8" />
                            </lists:ListItem.LeadingContent>
                            <lists:ListItem.TrailingContent>
                                <lists:ListItemCheckbox IsChecked="True" VerticalOptions="Center" />
                            </lists:ListItem.TrailingContent>
                        </lists:ListItem>
                    </DataTemplate>
                </views:CrudListViewSf.SelectedItemTemplate>

            </views:CrudListViewSf>
        </bottomsheet:SfBottomSheet.Content>
    </bottomsheet:SfBottomSheet>

</pages:CrudListPageBase>
