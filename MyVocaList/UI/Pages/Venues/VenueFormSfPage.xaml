<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:inputlayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    xmlns:media="clr-namespace:MyVocaList.UI.Components.Media"
    x:Class="MyVocaList.UI.Pages.Venues.VenueFormSfPage"
    x:DataType="vm:VenueFormViewModel"
    Title="{Binding PageTitle}"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="All">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <inputlayout:SfTextInputLayout Hint="Venue Name"
                                           ContainerType="Outlined"
                                           HasError="{Binding NameHasError}"
                                           ErrorText="{Binding NameErrorText}">
                <Entry x:Name="nameEdit"
                       Text="{Binding VenueName, Mode=TwoWay}"
                       MaxLength="60"
                       TextColor="{StaticResource OnSurface}"
                       Placeholder="Enter venue name"
                       PlaceholderColor="{StaticResource OnSurfaceVariant}"
                       Unfocused="OnNameUnfocused" />
            </inputlayout:SfTextInputLayout>

            <Label Text="{Binding CharacterCounterText}"
                   IsVisible="{Binding ShowCharacterCounter}"
                   StyleClass="Body.Small"
                   HorizontalOptions="End">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsCharacterCounterError}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Error}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsCharacterCounterWarning}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Warning}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- Form picture (REQ-VEN-08..11): the ViewModel owns which picture is shown, the buttons' state and the commands. -->
            <media:ImagePickerFieldSf ImageSource="{Binding FormImageSource}"
                                      ThumbnailSource="{Binding FormImageThumbnailSource}"
                                      PlaceholderIcon="nightlife_outlined"
                                      HasImage="{Binding HasFormImage}"
                                      HintText="{Binding ImageHintText}"
                                      PickCommand="{Binding PickImageCommand}"
                                      RemoveCommand="{Binding RemoveImageCommand}"
                                      IsBusy="{Binding IsImageBusy}" />

            <!-- Address section (REQ-VEN-12, 23) -->
            <Label Text="Address"
                   StyleClass="Title.Medium"
                   TextColor="{StaticResource OnSurface}" />

            <!-- Filled tonal look: SfFilledButton with the SecondaryContainer tokens (no Sf tonal style exists). -->
            <buttons:SfButton Text="{Binding MapButtonText}"
                              ImageSource="map_outlined"
                              ShowIcon="True"
                              Style="{StaticResource SfFilledButton}"
                              Background="{StaticResource SecondaryContainerBrush}"
                              TextColor="{StaticResource OnSecondaryContainer}"
                              HorizontalOptions="Fill"
                              Command="{Binding PickOnMapCommand}" />

            <Label Text="Find the place on the map to fill the address, or type it below."
                   StyleClass="Body.Small"
                   TextColor="{StaticResource OnSurfaceVariant}" />

            <inputlayout:SfTextInputLayout Hint="Street address"
                                           ContainerType="Outlined"
                                           HasError="{Binding AddressLine1HasError}"
                                           ErrorText="{Binding AddressLine1ErrorText}">
                <Entry
                       Text="{Binding AddressLine1, Mode=TwoWay}"
                       MaxLength="100"
                       TextColor="{StaticResource OnSurface}" />
            </inputlayout:SfTextInputLayout>

            <inputlayout:SfTextInputLayout Hint="Address line 2 (optional)"
                                           ContainerType="Outlined"
                                           HasError="{Binding AddressLine2HasError}"
                                           ErrorText="{Binding AddressLine2ErrorText}">
                <Entry
                       Text="{Binding AddressLine2, Mode=TwoWay}"
                       MaxLength="100"
                       TextColor="{StaticResource OnSurface}" />
            </inputlayout:SfTextInputLayout>

            <inputlayout:SfTextInputLayout Hint="City"
                                           ContainerType="Outlined"
                                           HasError="{Binding CityHasError}"
                                           ErrorText="{Binding CityErrorText}">
                <Entry
                       Text="{Binding City, Mode=TwoWay}"
                       MaxLength="80"
                       TextColor="{StaticResource OnSurface}" />
            </inputlayout:SfTextInputLayout>

            <inputlayout:SfTextInputLayout Hint="State / Province / Region"
                                           ContainerType="Outlined"
                                           HasError="{Binding RegionHasError}"
                                           ErrorText="{Binding RegionErrorText}">
                <Entry
                       Text="{Binding Region, Mode=TwoWay}"
                       MaxLength="80"
                       TextColor="{StaticResource OnSurface}" />
            </inputlayout:SfTextInputLayout>

            <inputlayout:SfTextInputLayout Hint="Postal code"
                                           ContainerType="Outlined"
                                           HasError="{Binding PostalCodeHasError}"
                                           ErrorText="{Binding PostalCodeErrorText}">
                <Entry
                       Text="{Binding PostalCode, Mode=TwoWay}"
                       MaxLength="20"
                       TextColor="{StaticResource OnSurface}" />
            </inputlayout:SfTextInputLayout>

            <inputlayout:SfTextInputLayout Hint="Country"
                                           ContainerType="Outlined"
                                           HasError="{Binding CountryHasError}"
                                           ErrorText="{Binding CountryErrorText}">
                <Entry
                       Text="{Binding Country, Mode=TwoWay}"
                       MaxLength="60"
                       TextColor="{StaticResource OnSurface}" />
            </inputlayout:SfTextInputLayout>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                <buttons:SfButton Text="Cancel"
                                  Style="{StaticResource SfOutlinedButton}"
                                  Padding="24,0"
                                  Command="{Binding CancelCommand}" />
                <buttons:SfButton Text="Save"
                                  Style="{StaticResource SfFilledButton}"
                                  Padding="24,0"
                                  Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
