<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    x:Class="MyVocaList.UI.Pages.Events.EventsPage"
    Title="Events"
    BackgroundColor="{StaticResource Surface}">

    <dx:DXScrollView>
        <VerticalStackLayout Style="{StaticResource PageContainer}">
            <dx:DXBorder BackgroundColor="{StaticResource SurfaceContainerLow}"
                         CornerRadius="12" Padding="24">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Events"
                           FontFamily="RobotoMedium" FontSize="32"
                           TextColor="{StaticResource OnSurface}" />
                    <Label Text="This page is under construction."
                           FontFamily="RobotoRegular" FontSize="14"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </dx:DXBorder>
        </VerticalStackLayout>
    </dx:DXScrollView>

</ContentPage>
