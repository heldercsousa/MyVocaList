<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyVocaList.UI.Pages.Samples.SamplesMenuPage"
             Title="DevExpress Samples">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">
            <Label Text="DevExpress Samples"
                   FontFamily="RobotoMedium"
                   FontSize="32"
                   TextColor="{StaticResource OnSurface}"/>

            <Label Text="Collection View Samples"
                   FontFamily="RobotoMedium"
                   FontSize="20"
                   TextColor="{StaticResource Primary}"/>

            <VerticalStackLayout Spacing="12">
                <Button Text="Swipe Container Sample"
                        StyleClass="FilledTonalButton"
                        Clicked="OnSwipeContainerClicked"/>

                <Button Text="Drag Drop Sample"
                        StyleClass="FilledTonalButton"
                        Clicked="OnDragDropClicked"/>

                <Button Text="Filter Chips Sample"
                        StyleClass="FilledTonalButton"
                        Clicked="OnFilterChipsClicked"/>
            </VerticalStackLayout>

            <Label Text="DataForm &amp; Editors Samples"
                   FontFamily="RobotoMedium"
                   FontSize="20"
                   TextColor="{StaticResource Primary}"
                   Margin="0,16,0,0"/>

            <VerticalStackLayout Spacing="12">
                <Button Text="Edit Form Sample"
                        StyleClass="FilledTonalButton"
                        Clicked="OnEditFormClicked"/>

                <Button Text="ComboBox Editor Sample"
                        StyleClass="FilledTonalButton"
                        Clicked="OnComboBoxEditorClicked"/>

                <Button Text="Editors Sample"
                        StyleClass="FilledTonalButton"
                        Clicked="OnEditorsClicked"/>
            </VerticalStackLayout>

            <Label Text="Navigation &amp; Dialog Samples"
                   FontFamily="RobotoMedium"
                   FontSize="20"
                   TextColor="{StaticResource Primary}"
                   Margin="0,16,0,0"/>

            <VerticalStackLayout Spacing="12">
                <Button Text="Bottom TabView Sample"
                        StyleClass="FilledTonalButton"
                        Clicked="OnTabViewClicked"/>

                <Button Text="Popup Service Sample"
                        StyleClass="FilledTonalButton"
                        Clicked="OnPopupClicked"/>

                <Button Text="BottomSheet Sample"
                        StyleClass="FilledTonalButton"
                        Clicked="OnBottomSheetClicked"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
