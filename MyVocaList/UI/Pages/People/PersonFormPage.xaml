<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
    xmlns:textfields="clr-namespace:MyVocaList.UI.Components.TextFields"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    xmlns:models="clr-namespace:MyVocaList.Contracts.Models;assembly=MyVocaList.Contracts"
    x:Class="MyVocaList.UI.Pages.People.PersonFormPage"
    x:DataType="vm:PersonFormViewModel"
    Title="{Binding PageTitle}"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="All">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Full Name with autocomplete suggestions (dedup) -->
            <textfields:AutocompleteDXField x:Name="nameField"
                                            LabelText="Full Name"
                                            PlaceholderText="First and last name"
                                            Text="{Binding PersonName, Mode=TwoWay}"
                                            HasError="{Binding NameHasError}"
                                            ErrorText="{Binding NameErrorText}"
                                            OptionSource="{Binding NameOptionSource}"
                                            SelectCommand="{Binding SuggestionSelectedCommand}"
                                            IsPickLockEnabled="False"
                                            BlurWithoutPickCommand="{Binding ValidateNameCommand}" />

            <!-- Character counter -->
            <Label Text="{Binding CharacterCounterText}"
                   IsVisible="{Binding ShowCharacterCounter}"
                   StyleClass="Body.Small"
                   HorizontalOptions="End">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsCharacterCounterError}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Error}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsCharacterCounterWarning}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Warning}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- Birthday (optional): day and month dropdowns, no year -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <dxe:ComboBoxEdit Grid.Column="0"
                                  LabelText="Birth day"
                                  ItemsSource="{Binding Days}"
                                  SelectedItem="{Binding SelectedBirthDay, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  ClearIconVisibility="Auto"
                                  HasError="{Binding BirthdayErrorOnDay}"
                                  ErrorText="{Binding BirthdayErrorText}" />

                <dxe:ComboBoxEdit Grid.Column="1"
                                  LabelText="Birth month"
                                  ItemsSource="{Binding Months}"
                                  DisplayMember="Name"
                                  SelectedItem="{Binding SelectedBirthMonth, Mode=TwoWay}"
                                  IsReadOnly="True"
                                  ClearIconVisibility="Auto"
                                  HasError="{Binding BirthdayErrorOnMonth}"
                                  ErrorText="{Binding BirthdayErrorText}" />
            </Grid>

            <!-- Email (optional) -->
            <dxe:TextEdit x:Name="emailEdit"
                          Text="{Binding PersonEmail, Mode=TwoWay}"
                          LabelText="Email (optional)"
                          PlaceholderText="singer@example.com"
                          Keyboard="Email"
                          HasError="{Binding EmailHasError}"
                          ErrorText="{Binding EmailErrorText}"
                          Unfocused="OnEmailUnfocused" />

            <!-- Action buttons -->
            <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                <dx:DXButton Content="Cancel"
                             Style="{StaticResource OutlinedButton}"
                             Padding="24,0"
                             Command="{Binding CancelCommand}" />
                <dx:DXButton Content="Save"
                             Style="{StaticResource FilledButton}"
                             Padding="24,0"
                             Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
