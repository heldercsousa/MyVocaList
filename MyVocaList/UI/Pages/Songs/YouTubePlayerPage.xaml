<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MyVocaList.UI.Pages.Songs.YouTubePlayerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    x:DataType="vm:YouTubePlayerViewModel"
    Title="Karaoke video"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="Container">

    <!-- The official IFrame player only; nothing is drawn over it (REQ-MSRC-07). -->
    <WebView x:Name="playerView"
             VerticalOptions="Start"
             HeightRequest="260" />
</ContentPage>
