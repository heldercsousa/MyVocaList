<?xml version="1.0" encoding="utf-8" ?>
<pages:CrudListPageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:dto="clr-namespace:MyVocaList.Contracts.DTOs.List;assembly=MyVocaList.Contracts"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    xmlns:pages="clr-namespace:MyVocaList.UI.Pages.Base"
    xmlns:appbars="clr-namespace:MyVocaList.UI.Components.AppBars"
    xmlns:lists="clr-namespace:MyVocaList.UI.Components.Lists"
    xmlns:views="clr-namespace:MyVocaList.UI.Components"
    x:Class="MyVocaList.UI.Pages.Songs.SongsPage"
    x:Name="page"
    x:DataType="vm:SongsViewModel"
    Title="Songs"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="Container">

    <!-- Suppress Shell's native back/hamburger icon.
         IsVisible=False: hides the Shell-rendered nav icon.
         IsEnabled=False: prevents Shell from intercepting the hardware back event so OnBackButtonPressed fires.
         OnBackButtonPressed handles all back/dismiss navigation (confirm sheet → default). -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <appbars:SmallAppBar
            Title="{Binding AppBarTitle}"
            Subtitle="{Binding AppBarSubtitle}"
            NavigationIcon="{Binding AppBarNavigationIcon}"
            NavigationCommand="{Binding AppBarNavigationCommand}"
            IsElevated="{Binding IsScrolled}" />
    </Shell.TitleView>

    <views:CrudListView
        ItemsSource="{Binding Songs}"
        SelectedItemsSource="{Binding SelectedSongsRaw}"
        IsEmptyNoItems="{Binding IsEmptyNoSongs}"
        SearchText="{Binding SearchText, Mode=TwoWay}"
        IsSearchBarElevated="{Binding IsScrolled}"
        SearchPlaceholder="Search songs..."
        EmptyNoItemsIllustration="music_note_outlined"
        EmptyNoItemsHeadline="No song registered"
        FabCommand="{Binding PrimaryFabCommand}"
        FabDescription="Add song">

        <views:CrudListView.ItemTemplate>
            <DataTemplate x:DataType="dto:SongListItemDto">
                <lists:ListItem Headline="{Binding Title}"
                                SupportingText="{Binding SupportingText}"
                                IsSelected="False">
                    <lists:ListItem.LeadingContent>
                        <lists:ListItemLeadingImage ImageSource="{Binding ImageUrl}" PlaceholderIcon="music_note_outlined" Margin="0,8" />
                    </lists:ListItem.LeadingContent>
                    <lists:ListItem.TrailingContent>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <dx:DXButton Icon="language_outlined"
                                         Style="{StaticResource StandardIconButton}"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type pages:CrudListPageBase}}, Path=BindingContext.LaunchYouTubeSearchCommand}"
                                         CommandParameter="{Binding .}" />
                            <lists:ListItemCheckbox VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </lists:ListItem.TrailingContent>
                </lists:ListItem>
            </DataTemplate>
        </views:CrudListView.ItemTemplate>

        <views:CrudListView.SelectedItemTemplate>
            <DataTemplate x:DataType="dto:SongListItemDto">
                <lists:ListItem Headline="{Binding Title}"
                                SupportingText="{Binding SupportingText}"
                                IsSelected="True">
                    <lists:ListItem.LeadingContent>
                        <lists:ListItemLeadingImage ImageSource="{Binding ImageUrl}" PlaceholderIcon="music_note_outlined" Margin="0,8" />
                    </lists:ListItem.LeadingContent>
                    <lists:ListItem.TrailingContent>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <dx:DXButton Icon="language_outlined"
                                         Style="{StaticResource StandardIconButton}"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type pages:CrudListPageBase}}, Path=BindingContext.LaunchYouTubeSearchCommand}"
                                         CommandParameter="{Binding .}" />
                            <lists:ListItemCheckbox IsChecked="True" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </lists:ListItem.TrailingContent>
                </lists:ListItem>
            </DataTemplate>
        </views:CrudListView.SelectedItemTemplate>

    </views:CrudListView>

</pages:CrudListPageBase>
