<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    xmlns:lists="clr-namespace:MyVocaList.UI.Components.Lists"
    xmlns:models="clr-namespace:MyVocaList.Contracts.Models;assembly=MyVocaList.Contracts"
    xmlns:dtoList="clr-namespace:MyVocaList.Contracts.DTOs.List;assembly=MyVocaList.Contracts"
    xmlns:resolution="clr-namespace:MyVocaList.Domain.Resolution;assembly=MyVocaList.Domain"
    xmlns:textfields="clr-namespace:MyVocaList.UI.Components.TextFields"
    xmlns:media="clr-namespace:MyVocaList.UI.Components.Media"
    x:Class="MyVocaList.UI.Pages.Songs.SongFormPage"
    x:DataType="vm:SongFormViewModel"
    Title="{Binding PageTitle}"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="All">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <!-- Root Grid so BottomSheets can overlay the ScrollView -->
    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="16">

                <!-- Title is the first field (REQ-SFT-01). A defined Title shows as Headline Medium text; a tap
                     opens the editor with the text kept and releases a picked Title (REQ-PIC-23..27). Add mode:
                     the search box over local songs and Deezer (REQ-SFT-02). Edit mode: plain editable text for
                     every song (IsSearchEnabled false, REQ-SFT-27, REQ-PIC-29). Blur validation runs
                     ValidateTitle (the VM's first check). -->
                <textfields:TapToEditField x:Name="titleTapField"
                                           Text="{Binding SongTitle}"
                                           TextStyleClass="Headline.Medium"
                                           HasError="{Binding TitleHasError}"
                                           IsEditing="{Binding IsTitleEditing, Mode=TwoWay}">
                    <textfields:AutocompleteDXField x:Name="titleField"
                                                    LabelText="Title"
                                                    PlaceholderText="Enter song title"
                                                    Text="{Binding SongTitle, Mode=TwoWay}"
                                                    IsLocked="{Binding IsTitleLocked, Mode=TwoWay}"
                                                    IsSearchEnabled="{Binding IsTitleSearchEnabled}"
                                                    SupportingText="{Binding TitleSupportingText}"
                                                    HasError="{Binding TitleHasError}"
                                                    ErrorText="{Binding TitleErrorText}"
                                                    OptionSource="{Binding TitleOptionSource}"
                                                    SelectCommand="{Binding SelectTitleCommand}"
                                                    ClearCommand="{Binding ClearTitleCommand}"
                                                    BlurWithoutPickCommand="{Binding ValidateTitleCommand}" />
                </textfields:TapToEditField>

                <Label Text="{Binding CharacterCounterText}"
                       IsVisible="{Binding ShowCharacterCounter}"
                       StyleClass="Body.Small"
                       HorizontalOptions="End">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsCharacterCounterError}"
                                     Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Error}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsCharacterCounterWarning}"
                                     Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Warning}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <!-- Song picture, directly below Title (REQ-PIC-12..16): 120 dp rounded square, upload,
                     replace and remove; nothing is stored before Save (REQ-PIC-17). -->
                <media:ImagePickerField ImageSource="{Binding FormImageSource}"
                                        ThumbnailSource="{Binding FormImageThumbnailSource}"
                                        PlaceholderIcon="music_note_outlined"
                                        HasImage="{Binding HasFormImage}"
                                        HintText="{Binding ImageHintText}"
                                        PickCommand="{Binding PickImageCommand}"
                                        RemoveCommand="{Binding RemoveImageCommand}"
                                        IsBusy="{Binding IsImageBusy}" />

                <!-- Artist (REQ-SFT-01): local artists only (REQ-SFT-16, REQ-PIC-29). A defined Artist shows as
                     Title Large text; a tap opens the editor with the text kept and releases the picked artist, in
                     add and edit mode, so the artist of a stored song can be changed (REQ-PIC-23..28, 31). A pick
                     or the resolution of the typed name on Save is decided by the VM and the Service. -->
                <textfields:TapToEditField x:Name="artistTapField"
                                           Text="{Binding ArtistSearchText}"
                                           TextStyleClass="Title.Large"
                                           HasError="{Binding ArtistHasError}"
                                           IsEditing="{Binding IsArtistEditing, Mode=TwoWay}">
                    <textfields:AutocompleteDXField x:Name="artistField"
                                                    LabelText="Artist"
                                                    PlaceholderText="Search artists..."
                                                    Text="{Binding ArtistSearchText, Mode=TwoWay}"
                                                    IsLocked="{Binding IsArtistLocked, Mode=TwoWay}"
                                                    HasError="{Binding ArtistHasError}"
                                                    ErrorText="{Binding ArtistErrorText}"
                                                    OptionSource="{Binding ArtistOptionSource}"
                                                    SelectCommand="{Binding SelectArtistCommand}"
                                                    ClearCommand="{Binding ClearArtistCommand}"
                                                    BlurWithoutPickCommand="{Binding ArtistBlurredWithoutSelectionCommand}" />
                </textfields:TapToEditField>

                <!-- Version field (Task 4.5 — empty = canonical version) -->
                <dxe:TextEdit Text="{Binding SongVersion, Mode=TwoWay}"
                              LabelText="Version (optional)"
                              PlaceholderText="e.g. Live, Acoustic, Remix"
                              HasError="{Binding VersionHasError}"
                              ErrorText="{Binding VersionErrorText}"
                              Unfocused="OnVersionUnfocused" />

                <dxe:TextEdit Text="{Binding FeaturedArtists, Mode=TwoWay}"
                              LabelText="Featured Artists"
                              PlaceholderText="e.g. feat. Ivete Sangalo" />

                <Editor Placeholder="Song lyrics (optional)"
                        Text="{Binding Lyrics, Mode=TwoWay}"
                        MaxLength="10000"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120"
                        BackgroundColor="{StaticResource SurfaceContainerHighest}"
                        TextColor="{StaticResource OnSurface}"
                        PlaceholderColor="{StaticResource OnSurfaceVariant}" />

                <!-- YouTube URLs section header -->
                <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Label Text="▶" TextColor="Red" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label Text="YouTube URLs" StyleClass="Title.Small" VerticalOptions="Center" />
                    <Label Text="optional" Opacity="0.5" StyleClass="Body.Small" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Saved / buffered URL list -->
                <VerticalStackLayout Spacing="4"
                                     BindableLayout.ItemsSource="{Binding KaraokeUrls}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtoList:SongKaraokeUrlDto">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding VideoId}"
                                           StyleClass="Body.Medium"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding PlayCount, StringFormat='{0} plays'}"
                                               StyleClass="Body.Small"
                                               TextColor="{StaticResource OnSurfaceVariant}" />
                                        <Label Text="{Binding DurationSeconds, Converter={StaticResource SecondsToMinutesConverter}}"
                                               StyleClass="Body.Small"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               IsVisible="{Binding DurationSeconds, Converter={StaticResource IsNotNullConverter}}" />
                                        <Border BackgroundColor="{StaticResource Primary}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="4,2"
                                                IsVisible="{Binding IsSuggested}">
                                            <Label Text="★ SUGGESTED" StyleClass="Body.Small" TextColor="{StaticResource OnPrimary}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Label}"
                                           StyleClass="Body.Small"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           IsVisible="{Binding Label, Converter={StaticResource IsNotNullConverter}}" />
                                </VerticalStackLayout>
                                <dx:DXButton Grid.Column="1"
                                             Content="✕"
                                             Style="{StaticResource OutlinedButton}"
                                             VerticalOptions="Center"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SongFormViewModel}}, Path=RemoveUrlCommand}"
                                             CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Search and paste strip -->
                <Border BackgroundColor="{StaticResource SurfaceContainerLow}"
                        StrokeThickness="0"
                        Padding="12"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="8">

                        <dx:DXButton Content="🔍 Search YouTube"
                                     Style="{StaticResource OutlinedButton}"
                                     HorizontalOptions="Fill"
                                     Command="{Binding LaunchYouTubeSearchCommand}"
                                     IsEnabled="{Binding CanLaunchYouTubeSearch}" />

                        <lists:ListItem
                            Headline="Search YouTube (API)"
                            IsVisible="{Binding HasYouTubeApiKey}">
                            <lists:ListItem.LeadingContent>
                                <dx:DXButton Style="{StaticResource StandardIconButton}"
                                             Icon="search_outlined"
                                             InputTransparent="True" />
                            </lists:ListItem.LeadingContent>
                            <lists:ListItem.TrailingContent>
                                <dx:DXButton Style="{StaticResource StandardIconButton}"
                                             Icon="arrow_forward_outlined"
                                             InputTransparent="True" />
                            </lists:ListItem.TrailingContent>
                            <lists:ListItem.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToYouTubeSearchCommand}" />
                            </lists:ListItem.GestureRecognizers>
                        </lists:ListItem>

                        <VerticalStackLayout Spacing="4"
                                             IsVisible="{Binding HasYouTubeApiKey, Converter={StaticResource InverseBoolConverter}}">
                            <Label Text="Add a YouTube API key in Settings to enable search."
                                   StyleClass="Body.Small"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                            <dx:DXButton Content="Go to Settings"
                                         Style="{StaticResource OutlinedButton}"
                                         HorizontalOptions="Start"
                                         Padding="16,0"
                                         Command="{Binding GoToSettingsCommand}" />
                        </VerticalStackLayout>

                        <Label Text="Or paste a YouTube URL"
                               StyleClass="Body.Small"
                               TextColor="{StaticResource OnSurfaceVariant}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <dxe:TextEdit Grid.Column="0"
                                          Text="{Binding PasteUrlInput, Mode=TwoWay}"
                                          PlaceholderText="https://youtu.be/..." />
                            <dx:DXButton Grid.Column="1"
                                         Content="Add"
                                         Style="{StaticResource FilledButton}"
                                         VerticalOptions="End"
                                         Padding="16,0"
                                         Command="{Binding AddFromPasteCommand}" />
                        </Grid>
                        <Label Text="{Binding PasteUrlError}"
                               IsVisible="{Binding HasPasteUrlError}"
                               StyleClass="Body.Small"
                               TextColor="{StaticResource Error}" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ── Resolution BottomSheet (Task 4.5) ──────────────────────────────── -->
        <!--
            Shown when the resolution engine returns a non-NoMatch result.
            Lists exact/fuzzy candidates; user chooses Open existing, Save as new version, or Cancel.
        -->
        <dx:BottomSheet x:Name="resolutionSheet"
                        AllowedState="All"
                        HalfExpandedRatio="0.7"
                        IsModal="True"
                        ShowGrabber="True"
                        AllowDismiss="True"
                        BackgroundColor="{StaticResource Surface}"
                        CornerRadius="28"
                        StateChanged="OnResolutionSheetStateChanged">
            <!-- BUG-084: body scrolls; Cancel is pinned in row 1 so a long candidate list cannot push it out of reach. -->
            <Grid RowDefinitions="*,Auto">

                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Padding="0,0,0,8">

                        <Label Text="{Binding ResolutionSheetTitle}"
                               Style="{StaticResource BottomSheetTitle}"
                               Margin="24,20,24,8" />

                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Candidate list (exact or fuzzy matches) -->
                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding ResolutionCandidates}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="resolution:SongMatch">
                                    <Grid ColumnDefinitions="*,Auto" Padding="24,12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Title}"
                                                   StyleClass="Body.Large"
                                                   TextColor="{StaticResource OnSurface}" />
                                            <Label Text="{Binding ArtistName}"
                                                   StyleClass="Body.Small"
                                                   TextColor="{StaticResource OnSurfaceVariant}" />
                                            <Label Text="{Binding Version}"
                                                   StyleClass="Body.Small"
                                                   TextColor="{StaticResource OnSurfaceVariant}"
                                                   IsVisible="{Binding Version, Converter={StaticResource IsNotNullConverter}}" />
                                        </VerticalStackLayout>
                                        <dx:DXButton Grid.Column="1"
                                                     Content="Open existing"
                                                     Style="{StaticResource OutlinedButton}"
                                                     Padding="16,0"
                                                     VerticalOptions="Center"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SongFormViewModel}}, Path=OpenExistingSongCommand}"
                                                     CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Save as new version option (exact duplicate only; REQ-SFT-22) -->
                        <VerticalStackLayout Padding="24,12" Spacing="8"
                                             IsVisible="{Binding IsExactDuplicate}">
                            <Label Text="Or save as a new version:"
                                   StyleClass="Body.Small"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                            <!-- Version entry — revealed when user taps Save As New Version -->
                            <dxe:TextEdit Text="{Binding SongVersion, Mode=TwoWay}"
                                          LabelText="Version label (required)"
                                          PlaceholderText="e.g. Live, Acoustic, Remix 2010"
                                          HasError="{Binding VersionHasError}"
                                          ErrorText="{Binding VersionErrorText}"
                                          IsVisible="{Binding VersionEntryRequired}"
                                          Unfocused="OnVersionUnfocused" />
                            <dx:DXButton Content="Save as new version"
                                         Style="{StaticResource OutlinedButton}"
                                         HorizontalOptions="Fill"
                                         Command="{Binding ConfirmSaveAsNewVersionCommand}" />
                        </VerticalStackLayout>

                        <!-- Save as new song option (possible duplicates only; REQ-SFT-23, no Version needed) -->
                        <VerticalStackLayout Padding="24,12" Spacing="8"
                                             IsVisible="{Binding IsExactDuplicate, Converter={StaticResource InverseBoolConverter}}">
                            <dx:DXButton Content="Save as new song"
                                         Style="{StaticResource OutlinedButton}"
                                         HorizontalOptions="Fill"
                                         Command="{Binding ConfirmSaveAsNewSongCommand}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Row="1" Padding="0,0,0,24">
                    <BoxView Style="{StaticResource Divider}" />

                    <dx:DXButton Content="Cancel"
                                 Style="{StaticResource BottomSheetCancelAction}"
                                 Command="{Binding DismissResolutionSheetCommand}" />
                </VerticalStackLayout>

            </Grid>
        </dx:BottomSheet>

        <!-- ── Artist-match BottomSheet (Task 5.3, REQ-SFT-19) ─────────────────── -->
        <!--
            Shown when the Service finds near-duplicate artists for the typed name. Lists the
            candidates best-first; the user chooses Use '<existing>', Create '<typed>' or Cancel.
            Back or scrim saves nothing (DismissArtistMatchSheetCommand).
        -->
        <dx:BottomSheet x:Name="artistMatchSheet"
                        AllowedState="All"
                        HalfExpandedRatio="0.7"
                        IsModal="True"
                        ShowGrabber="True"
                        AllowDismiss="True"
                        BackgroundColor="{StaticResource Surface}"
                        CornerRadius="28"
                        StateChanged="OnArtistMatchSheetStateChanged">
            <!-- BUG-084: body scrolls; Cancel is pinned in row 1 so a long candidate list cannot push it out of reach. -->
            <Grid RowDefinitions="*,Auto">

                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Padding="0,0,0,8">

                        <Label Text="Similar artist found"
                               Style="{StaticResource BottomSheetTitle}"
                               Margin="24,20,24,8" />

                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Candidate list (near-duplicate artists, best first) -->
                        <VerticalStackLayout Spacing="0"
                                             BindableLayout.ItemsSource="{Binding ArtistMatchCandidates}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="resolution:ArtistMatch">
                                    <Grid ColumnDefinitions="*,Auto" Padding="24,12">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               StyleClass="Body.Large"
                                               TextColor="{StaticResource OnSurface}"
                                               VerticalOptions="Center" />
                                        <dx:DXButton Grid.Column="1"
                                                     Content="{Binding Name, StringFormat='Use \'{0}\''}"
                                                     Style="{StaticResource OutlinedButton}"
                                                     Padding="16,0"
                                                     VerticalOptions="Center"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SongFormViewModel}}, Path=UseExistingArtistCommand}"
                                                     CommandParameter="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Create the typed name as a new artist -->
                        <VerticalStackLayout Padding="24,12" Spacing="8">
                            <dx:DXButton Content="{Binding ArtistMatchTypedName, StringFormat='Create \'{0}\''}"
                                         Style="{StaticResource OutlinedButton}"
                                         HorizontalOptions="Fill"
                                         Command="{Binding CreateTypedArtistCommand}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Row="1" Padding="0,0,0,24">
                    <BoxView Style="{StaticResource Divider}" />

                    <dx:DXButton Content="Cancel"
                                 Style="{StaticResource BottomSheetCancelAction}"
                                 Command="{Binding DismissArtistMatchSheetCommand}" />
                </VerticalStackLayout>

            </Grid>
        </dx:BottomSheet>

    </Grid>

</ContentPage>
