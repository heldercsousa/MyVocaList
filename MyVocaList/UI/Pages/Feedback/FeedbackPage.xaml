<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
    xmlns:inputlayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
    xmlns:sfinputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    x:Class="MyVocaList.UI.Pages.Feedback.FeedbackPage"
    x:DataType="vm:FeedbackViewModel"
    Title="Send Feedback"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="All">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="What's on your mind?"
                StyleClass="Title.Medium"
                TextColor="{StaticResource OnSurface}" />

            <Label
                Text="Your feedback helps improve MyVocaList. Bug reports include device info automatically."
                StyleClass="Body.Small"
                TextColor="{StaticResource OnSurfaceVariant}" />

            <!-- Category -->
            <inputlayout:SfTextInputLayout
                Hint="Category"
                IsHintAlwaysFloated="True"
                ContainerType="Outlined">
                <inputlayout:SfTextInputLayout.HintLabelStyle>
                    <inputlayout:LabelStyle TextColor="{StaticResource OnSurfaceVariant}" />
                </inputlayout:SfTextInputLayout.HintLabelStyle>
                <sfinputs:SfComboBox
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                    IsEditable="False"
                    IsClearButtonVisible="False"
                    ShowBorder="False"
                    TextColor="{StaticResource OnSurface}"
                    Background="{StaticResource Surface}"
                    DropDownBackground="{StaticResource SurfaceContainer}"
                    DropDownItemTextColor="{StaticResource OnSurface}"
                    DropDownIconColor="{StaticResource OnSurfaceVariant}"
                    SelectedDropDownItemBackground="{StaticResource PrimaryContainer}">
                    <sfinputs:SfComboBox.SelectedDropDownItemTextStyle>
                        <sfinputs:DropDownTextStyle TextColor="{StaticResource OnPrimaryContainer}" />
                    </sfinputs:SfComboBox.SelectedDropDownItemTextStyle>
                </sfinputs:SfComboBox>
            </inputlayout:SfTextInputLayout>

            <!-- Message -->
            <inputlayout:SfTextInputLayout
                Hint="Message"
                ContainerType="Outlined">
                <inputlayout:SfTextInputLayout.HintLabelStyle>
                    <inputlayout:LabelStyle TextColor="{StaticResource OnSurfaceVariant}" />
                </inputlayout:SfTextInputLayout.HintLabelStyle>
                <Editor
                    x:Name="messageEditor"
                    Text="{Binding Message, Mode=TwoWay}"
                    Placeholder="Describe the issue or feature request..."
                    PlaceholderColor="{StaticResource OnSurfaceVariant}"
                    TextColor="{StaticResource OnSurface}"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="120"
                    MaxLength="1000" />
            </inputlayout:SfTextInputLayout>

            <!-- Character counter: SfTextInputLayout does not count a stock Editor, so mirror the text length -->
            <Label
                Text="{Binding Source={x:Reference messageEditor}, x:DataType=Editor, Path=Text.Length, StringFormat='{0} / 1000', FallbackValue='0 / 1000'}"
                StyleClass="Body.Small"
                TextColor="{StaticResource OnSurfaceVariant}"
                HorizontalOptions="End" />

            <!-- Email (optional) -->
            <inputlayout:SfTextInputLayout
                Hint="Contact email (optional)"
                ContainerType="Outlined">
                <inputlayout:SfTextInputLayout.HintLabelStyle>
                    <inputlayout:LabelStyle TextColor="{StaticResource OnSurfaceVariant}" />
                </inputlayout:SfTextInputLayout.HintLabelStyle>
                <Entry
                    Text="{Binding Email, Mode=TwoWay}"
                    Placeholder="your@email.com"
                    PlaceholderColor="{StaticResource OnSurfaceVariant}"
                    TextColor="{StaticResource OnSurface}"
                    Keyboard="Email" />
            </inputlayout:SfTextInputLayout>

            <!-- Submit -->
            <buttons:SfButton
                Text="Send Feedback"
                Style="{StaticResource SfFilledButton}"
                HorizontalOptions="Fill"
                Command="{Binding SubmitCommand}" />

            <ActivityIndicator
                IsRunning="{Binding IsSubmitting}"
                IsVisible="{Binding IsSubmitting}"
                Color="{StaticResource Primary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
