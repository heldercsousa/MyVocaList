<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    xmlns:dtoList="clr-namespace:MyVocaList.Contracts.DTOs.List;assembly=MyVocaList.Contracts"
    xmlns:lists="clr-namespace:MyVocaList.UI.Components.Lists"
    x:Class="MyVocaList.UI.Pages.Artists.ArtistFormPage"
    x:DataType="vm:ArtistFormViewModel"
    Title="{Binding PageTitle}"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="All">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <dxe:TextEdit x:Name="nameEdit"
                          Text="{Binding ArtistName, Mode=TwoWay}"
                          LabelText="Artist Name"
                          PlaceholderText="Enter artist name"
                          MaxCharacterCount="60"
                          HasError="{Binding NameHasError}"
                          ErrorText="{Binding NameErrorText}"
                          Unfocused="OnNameUnfocused" />

            <Label Text="{Binding CharacterCounterText}"
                   IsVisible="{Binding ShowCharacterCounter}"
                   StyleClass="Body.Small"
                   HorizontalOptions="End">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsCharacterCounterError}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Error}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsCharacterCounterWarning}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Warning}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- Duplicate suggestions from local catalog -->
            <VerticalStackLayout IsVisible="{Binding HasDuplicateSuggestions}" Spacing="4">
                <Label Text="Artist already exists in your catalog:"
                       StyleClass="Body.Small"
                       TextColor="{StaticResource Warning}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DuplicateSuggestions}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dtoList:ArtistListItemDto">
                            <dx:DXButton Content="{Binding Name}"
                                         Style="{StaticResource OutlinedButton}"
                                         HorizontalOptions="Start"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistFormViewModel}}, Path=SelectDuplicateCommand}"
                                         CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Navigate to artist picker -->
            <lists:ListItem Headline="Search music database">
                <lists:ListItem.LeadingContent>
                    <dx:DXButton Style="{StaticResource StandardIconButton}"
                                 Icon="search_outlined"
                                 InputTransparent="True" />
                </lists:ListItem.LeadingContent>
                <lists:ListItem.TrailingContent>
                    <dx:DXButton Style="{StaticResource StandardIconButton}"
                                 Icon="arrow_forward_outlined"
                                 InputTransparent="True" />
                </lists:ListItem.TrailingContent>
                <lists:ListItem.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToArtistPickerCommand}" />
                </lists:ListItem.GestureRecognizers>
            </lists:ListItem>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                <dx:DXButton Content="Cancel"
                             Style="{StaticResource OutlinedButton}"
                             Padding="24,0"
                             Command="{Binding CancelCommand}" />
                <dx:DXButton Content="Save"
                             Style="{StaticResource FilledButton}"
                             Padding="24,0"
                             Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
