<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    xmlns:readModels="clr-namespace:MyVocaList.Domain.ReadModels;assembly=MyVocaList.Domain"
    xmlns:textfields="clr-namespace:MyVocaList.UI.Components.TextFields"
    xmlns:media="clr-namespace:MyVocaList.UI.Components.Media"
    x:Class="MyVocaList.UI.Pages.Artists.ArtistFormPage"
    x:DataType="vm:ArtistFormViewModel"
    Title="{Binding PageTitle}"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="All">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Name (REQ-PIC-33, 37): the shared autocomplete field. Add mode: local artists, then Deezer;
                 a local pick opens that artist, a Deezer pick fills Name in the picked state. Edit mode:
                 plain editable text (IsSearchEnabled false). A defined Name reads as Headline Medium text
                 and a tap opens the editor (REQ-PIC-23..26). Blur validation runs ValidateName. -->
            <textfields:TapToEditField x:Name="nameTapToEdit"
                                       Text="{Binding ArtistName}"
                                       TextStyleClass="Headline.Medium"
                                       HasError="{Binding NameHasError}"
                                       IsEditing="{Binding IsNameEditing, Mode=TwoWay}">
                <textfields:AutocompleteDXField x:Name="nameField"
                                                LabelText="Artist Name"
                                                PlaceholderText="Enter artist name"
                                                Text="{Binding ArtistName, Mode=TwoWay}"
                                                IsLocked="{Binding IsNameLocked, Mode=TwoWay}"
                                                IsSearchEnabled="{Binding IsNameSearchEnabled}"
                                                SupportingText="{Binding NameSupportingText}"
                                                HasError="{Binding NameHasError}"
                                                ErrorText="{Binding NameErrorText}"
                                                OptionSource="{Binding NameOptionSource}"
                                                SelectCommand="{Binding SelectNameCommand}"
                                                ClearCommand="{Binding ClearNameCommand}"
                                                BlurWithoutPickCommand="{Binding ValidateNameCommand}" />
            </textfields:TapToEditField>

            <Label Text="{Binding CharacterCounterText}"
                   IsVisible="{Binding ShowCharacterCounter}"
                   StyleClass="Body.Small"
                   HorizontalOptions="End">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsCharacterCounterError}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Error}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsCharacterCounterWarning}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Warning}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- Form picture (REQ-PIC-12..16, 35): a 120 dp circle directly below Name. The ViewModel owns
                 which picture is shown, the buttons' state (HasFormImage) and the commands. -->
            <media:ImagePickerField ImageSource="{Binding FormImageSource}"
                                    ThumbnailSource="{Binding FormImageThumbnailSource}"
                                    PlaceholderIcon="account_circle_outlined"
                                    IsCircle="True"
                                    HasImage="{Binding HasFormImage}"
                                    HintText="{Binding ImageHintText}"
                                    PickCommand="{Binding PickImageCommand}"
                                    RemoveCommand="{Binding RemoveImageCommand}"
                                    IsBusy="{Binding IsImageBusy}" />

            <!-- Duplicate suggestions from local catalog -->
            <VerticalStackLayout IsVisible="{Binding HasDuplicateSuggestions}" Spacing="4">
                <Label Text="Artist already exists in your catalog:"
                       StyleClass="Body.Small"
                       TextColor="{StaticResource Warning}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DuplicateSuggestions}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="readModels:ArtistListItem">
                            <dx:DXButton Content="{Binding Name}"
                                         Style="{StaticResource OutlinedButton}"
                                         HorizontalOptions="Start"
                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArtistFormViewModel}}, Path=SelectDuplicateCommand}"
                                         CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                <dx:DXButton Content="Cancel"
                             Style="{StaticResource OutlinedButton}"
                             Padding="24,0"
                             Command="{Binding CancelCommand}" />
                <dx:DXButton Content="Save"
                             Style="{StaticResource FilledButton}"
                             Padding="24,0"
                             Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
