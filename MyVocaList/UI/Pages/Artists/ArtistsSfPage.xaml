<?xml version="1.0" encoding="utf-8" ?>
<pages:CrudListPageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
    xmlns:dto="clr-namespace:MyVocaList.Contracts.DTOs.List;assembly=MyVocaList.Contracts"
    xmlns:domain="clr-namespace:MyVocaList.Domain.ReadModels;assembly=MyVocaList.Domain"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    xmlns:pages="clr-namespace:MyVocaList.UI.Pages.Base"
    xmlns:appbars="clr-namespace:MyVocaList.UI.Components.AppBars"
    xmlns:lists="clr-namespace:MyVocaList.UI.Components.Lists"
    xmlns:views="clr-namespace:MyVocaList.UI.Components"
    x:Class="MyVocaList.UI.Pages.Artists.ArtistsSfPage"
    x:Name="page"
    x:DataType="vm:ArtistsViewModel"
    Title="Artists"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="Container">

    <Shell.TitleView>
        <appbars:SmallAppBarSf
            Title="{Binding AppBarTitle}"
            IsElevated="{Binding IsScrolled}" />
    </Shell.TitleView>

    <views:CrudListViewSf
        ItemsSource="{Binding Artists}"
        SelectedItemsSource="{Binding SelectedArtistsRaw}"
        IsEmptyNoItems="{Binding IsEmptyNoArtists}"
        SearchText="{Binding SearchText, Mode=TwoWay}"
        IsSearchBarElevated="{Binding IsScrolled}"
        SearchPlaceholder="Search artists..."
        EmptyNoItemsIllustration="group_outlined"
        EmptyNoItemsHeadline="No artist registered"
        FabCommand="{Binding AddArtistCommand}"
        FabDescription="Add artist">

        <views:CrudListViewSf.FilterContent>
            <chips:SfChipGroup ChipType="Filter"
                               SelectedItems="{Binding SelectedRoleFilters, Mode=TwoWay}"
                               Margin="16,4,16,4">
                <chips:SfChipGroup.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Authors</x:String>
                        <x:String>Performers</x:String>
                    </x:Array>
                </chips:SfChipGroup.ItemsSource>
            </chips:SfChipGroup>
        </views:CrudListViewSf.FilterContent>

        <views:CrudListViewSf.ItemTemplate>
            <DataTemplate x:DataType="domain:ArtistListItem">
                <lists:ListItem Headline="{Binding Name}"
                                SupportingText="{Binding CatalogCountText}"
                                IsSelected="False">
                    <lists:ListItem.LeadingContent>
                        <lists:ListItemLeadingAvatarSf ImageSource="{Binding ImageUrl, Converter={StaticResource ImageReferenceConverter}}" />
                    </lists:ListItem.LeadingContent>
                    <lists:ListItem.TrailingContent>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <ImageButton x:DataType="{x:Null}" Style="{StaticResource SfIconButton}"
                                         Source="queue_music_outlined"
                                         SemanticProperties.Description="View catalog"
                                         Command="{Binding Source={x:Reference page}, Path=BindingContext.ViewCatalogCommand}"
                                         CommandParameter="{Binding .}"
                                         InputTransparent="False" />
                            <lists:ListItemCheckboxSf VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </lists:ListItem.TrailingContent>
                </lists:ListItem>
            </DataTemplate>
        </views:CrudListViewSf.ItemTemplate>

        <views:CrudListViewSf.SelectedItemTemplate>
            <DataTemplate x:DataType="domain:ArtistListItem">
                <lists:ListItem Headline="{Binding Name}"
                                SupportingText="{Binding CatalogCountText}"
                                IsSelected="True">
                    <lists:ListItem.LeadingContent>
                        <lists:ListItemLeadingAvatarSf ImageSource="{Binding ImageUrl, Converter={StaticResource ImageReferenceConverter}}" />
                    </lists:ListItem.LeadingContent>
                    <lists:ListItem.TrailingContent>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <ImageButton x:DataType="{x:Null}" Style="{StaticResource SfIconButton}"
                                         Source="queue_music_outlined"
                                         SemanticProperties.Description="View catalog"
                                         Command="{Binding Source={x:Reference page}, Path=BindingContext.ViewCatalogCommand}"
                                         CommandParameter="{Binding .}"
                                         InputTransparent="False" />
                            <lists:ListItemCheckboxSf IsChecked="True" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </lists:ListItem.TrailingContent>
                </lists:ListItem>
            </DataTemplate>
        </views:CrudListViewSf.SelectedItemTemplate>

    </views:CrudListViewSf>

</pages:CrudListPageBase>
