<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    x:Class="MyVocaList.UI.Pages.Queue.QueuePage"
    Title="Queue"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="Container">

    <Grid>
        <dx:DXScrollView>
            <VerticalStackLayout Style="{StaticResource PageContainer}">
                <dx:DXBorder BackgroundColor="{StaticResource SurfaceContainerLow}"
                             CornerRadius="12" Padding="24">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Queue"
                               FontFamily="RobotoMedium" FontSize="32"
                               TextColor="{StaticResource OnSurface}" />
                        <Label Text="This page is under construction."
                               FontFamily="RobotoRegular" FontSize="14"
                               TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                </dx:DXBorder>
            </VerticalStackLayout>
        </dx:DXScrollView>

        <!-- Exit confirmation -->
        <dx:BottomSheet x:Name="exitConfirmSheet"
                        HalfExpandedRatio="0.28"
                        AllowedState="HalfExpanded"
                        IsModal="True"
                        ShowGrabber="True"
                        AllowDismiss="True"
                        BackgroundColor="{StaticResource Surface}"
                        CornerRadius="28">
            <VerticalStackLayout>
                <Label Text="Exit MyVocaList?"
                       FontFamily="RobotoMedium" FontSize="16"
                       TextColor="{StaticResource OnSurface}"
                       HorizontalTextAlignment="Center"
                       Margin="24,20" />
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />
                <dx:DXButton Content="Exit"
                             BackgroundColor="Transparent"
                             TextColor="{StaticResource Error}"
                             HorizontalOptions="Fill"
                             HeightRequest="56"
                             Clicked="OnConfirmExit" />
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource OutlineVariant}" />
                <dx:DXButton Content="Cancel"
                             BackgroundColor="Transparent"
                             TextColor="{StaticResource Primary}"
                             HorizontalOptions="Fill"
                             HeightRequest="56"
                             Clicked="OnCancelExit" />
            </VerticalStackLayout>
        </dx:BottomSheet>
    </Grid>

</ContentPage>
