<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    x:Class="MyVocaList.UI.Pages.Queue.QueueSongPickerPage"
    x:DataType="vm:QueueSongPickerViewModel"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="Container">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="auto,*">
        <!-- Search -->
        <dx:DXTextEdit
            Grid.Row="0"
            Placeholder="Search songs..."
            Text="{Binding SearchText, Mode=TwoWay}"
            Margin="16"
            ClearButtonDisplayMode="WhileEditing" />

        <!-- Results -->
        <dx:DXCollectionView
            Grid.Row="1"
            ItemsSource="{Binding Results}"
            SelectionMode="Single"
            SelectionChangedCommand="{Binding SelectSongCommand}">
            <dx:DXCollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="16" Spacing="4">
                        <Label Text="{Binding Title}" StyleClass="Body.Large" />
                        <Label Text="{Binding Artist}" StyleClass="Body.Small" TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </dx:DXCollectionView.ItemTemplate>
        </dx:DXCollectionView>

        <!-- Empty -->
        <Label
            Grid.Row="1"
            Text="No songs available"
            TextColor="{StaticResource OnSurfaceVariant}"
            HorizontalTextAlignment="Center"
            VerticalOptions="Center"
            IsVisible="{Binding Results.Count, Converter={StaticResource CountEqualsZeroConverter}}" />
    </Grid>
</ContentPage>
