<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:vm="clr-namespace:MyVocaList.UI.ViewModels"
    xmlns:models="clr-namespace:MyVocaList.UI.Models"
    xmlns:queue="clr-namespace:MyVocaList.UI.Components"
    xmlns:sheets="clr-namespace:MyVocaList.UI.Components.Sheets"
    x:Class="MyVocaList.UI.Pages.Queue.QueueManagementPage"
    x:DataType="vm:QueueManagementViewModel"
    Title="Queue"
    BackgroundColor="{StaticResource Surface}"
    SafeAreaEdges="Container">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="*,auto">
        <!-- Main Content -->
        <dx:DXScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="16">
                <!-- Event Info -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding CurrentEvent.Name, StringFormat='Event: {0}'}"
                           StyleClass="Title.Large" TextColor="{StaticResource OnSurface}" />
                    <Label Text="{Binding EventStatusDisplay}"
                           StyleClass="Body.Medium" TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>

                <!-- Current Singer Card -->
                <queue:CurrentSingerCard BindingContext="{Binding CurrentSinger}" />

                <!-- Next Up Label -->
                <Label Text="Next Up" StyleClass="Title.Medium" TextColor="{StaticResource OnSurface}" />

                <!-- Next Up Queue -->
                <dx:DXCollectionView
                    ItemsSource="{Binding NextUpQueue}"
                    SelectionMode="None"
                    HeightRequest="300">
                    <dx:DXCollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueEntryViewModel">
                            <queue:QueueListItem />
                        </DataTemplate>
                    </dx:DXCollectionView.ItemTemplate>
                </dx:DXCollectionView>

                <!-- Add Singer Button -->
                <dx:DXButton
                    Content="+ Add Singer"
                    Command="{Binding OpenPersonPickerCommand}"
                    HorizontalOptions="Fill"
                    HeightRequest="48" />

                <!-- History Label -->
                <Label Text="History" StyleClass="Title.Medium" TextColor="{StaticResource OnSurface}"
                       Margin="0,16,0,0" />

                <!-- History List -->
                <dx:DXCollectionView
                    ItemsSource="{Binding History}"
                    SelectionMode="None"
                    HeightRequest="150">
                    <dx:DXCollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueEntryViewModel">
                            <queue:QueueListItem />
                        </DataTemplate>
                    </dx:DXCollectionView.ItemTemplate>
                </dx:DXCollectionView>
            </VerticalStackLayout>
        </dx:DXScrollView>

        <!-- Action Bar -->
        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="8" BackgroundColor="{StaticResource SurfaceContainerLow}">
            <dx:DXButton
                Content="Start Event"
                Command="{Binding StartEventCommand}"
                HorizontalOptions="Fill"
                HeightRequest="48"
                IsVisible="{Binding IsEventStarted, Converter={StaticResource InverseBoolConverter}}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsEventStarted}">
                <dx:DXButton
                    Grid.Column="0"
                    Content="Pause"
                    Command="{Binding PauseEventCommand}"
                    HorizontalOptions="Fill"
                    HeightRequest="48" />
                <dx:DXButton
                    Grid.Column="1"
                    Content="Finish"
                    Command="{Binding RequestFinishEventCommand}"
                    HorizontalOptions="Fill"
                    HeightRequest="48" />
            </Grid>
        </VerticalStackLayout>

        <!-- Finish-event confirmation (AC-5.3) — reuses the safe ConfirmSheet wrapper,
             driven by FinishConfirmSheetState (TwoWay). Wrapping the modal BottomSheet in a
             ContentView avoids the cached-page re-parent collision (BUG-011). -->
        <sheets:ConfirmSheet
            x:Name="finishConfirmSheet"
            Grid.Row="0" Grid.RowSpan="2"
            SheetState="{Binding FinishConfirmSheetState, Mode=TwoWay}"
            Message="End event and archive queue?"
            ActionText="Finish Event"
            ActionCommand="{Binding FinishEventCommand}"
            DismissCommand="{Binding DismissFinishConfirmCommand}" />
    </Grid>
</ContentPage>
