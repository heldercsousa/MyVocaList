<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="MyVocaList.UI.Pages.DesignSystem.DSInputsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="clr-namespace:UraniumUI.Material.Controls;assembly=UraniumUI.Material"
    Title="Inputs">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContainer}">

            <Label Text="Material Design 3 Inputs" StyleClass="Headline.Large" />
            <Label Text="Text fields and selection controls" StyleClass="Body.Medium"
                   TextColor="{StaticResource OnSurfaceVariant}" />

            <VerticalStackLayout Style="{StaticResource SectionContainer}">
                <Label Text="Text Fields (UraniumUI)" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                <Label Text="UraniumUI TextField provides MD3-compliant text input with validation support"
                       StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />

                <material:TextField Title="Standard Input" />
                <Label Text="Basic text field with label" StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />

                <material:TextField Title="With AccentColor" AccentColor="{StaticResource Primary}" />
                <Label Text="Text field with custom accent color" StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />

                <material:TextField Title="Multiline Input" MaxLength="200" />
                <Label Text="Text field with character limit" StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource SectionContainer}">
                <Label Text="Selection Controls" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                <Label Text="Native MAUI controls styled with MD3 semantic colors"
                       StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />

                <HorizontalStackLayout>
                    <CheckBox Style="{StaticResource MD3CheckBox}" />
                    <Label Text="Checkbox option" StyleClass="Body.Medium" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="Binary selection with Primary color accent" StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />

                <HorizontalStackLayout>
                    <CheckBox Style="{StaticResource MD3CheckBox}" IsChecked="True" />
                    <Label Text="Checked state" StyleClass="Body.Medium" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Switch Style="{StaticResource MD3Switch}" />
                    <Label Text="Toggle switch (off)" StyleClass="Body.Medium" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="Binary state toggle with smooth animation" StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />

                <HorizontalStackLayout>
                    <Switch Style="{StaticResource MD3Switch}" IsToggled="True" />
                    <Label Text="Toggle switch (on)" StyleClass="Body.Medium" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource SectionContainer}">
                <Label Text="Slider Control" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                <Label Text="Volume" StyleClass="Label.Medium" />
                <Slider Style="{StaticResource MD3Slider}"
                        Minimum="0"
                        Maximum="100"
                        Value="50" />
                <Label Text="Continuous value selection with Primary color track" StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />
            </VerticalStackLayout>

            <VerticalStackLayout Style="{StaticResource SectionContainer}">
                <Label Text="Date &amp; Time Pickers" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                <Frame Style="{StaticResource FilledCard}">
                    <VerticalStackLayout>
                        <Label Text="📱 MDC Pickers Note" StyleClass="Title.Small"
                               TextColor="{StaticResource Primary}" />
                        <Label StyleClass="Body.Small" TextColor="{StaticResource OnSurfaceVariant}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="HorusStudio MDC MaterialDatePicker/MaterialTimePicker are mobile-only (Android/iOS) and do not support Windows." />
                                    <Span Text="&#x0a;&#x0a;" />
                                    <Span Text="Solution:" FontAttributes="Bold" />
                                    <Span Text=" Using native MAUI DatePicker and TimePicker for cross-platform compatibility. Styled with MD3 semantic colors via MaterialStyles.xaml." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Select Date" StyleClass="Label.Medium" />
                <DatePicker Date="2026-01-28"
                            TextColor="{StaticResource OnSurface}"
                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                            MinimumHeightRequest="48" />
                <Label Text="Native DatePicker with MD3 colors" StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />

                <Label Text="Select Time" StyleClass="Label.Medium" />
                <TimePicker Time="14:30:00"
                            TextColor="{StaticResource OnSurface}"
                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                            MinimumHeightRequest="48" />
                <Label Text="Native TimePicker with MD3 colors" StyleClass="Body.Small"
                       TextColor="{StaticResource OnSurfaceVariant}" />
            </VerticalStackLayout>

            <Frame Style="{StaticResource FilledCard}">
                <VerticalStackLayout>
                    <Label Text="Input Component Guidelines" StyleClass="Title.Medium" />
                    <Label StyleClass="Body.Medium" TextColor="{StaticResource OnSurfaceVariant}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Text Fields: " FontAttributes="Bold" />
                                <Span Text="Use for user text input with labels and validation" />
                                <Span Text="&#x0a;&#x0a;" />
                                <Span Text="CheckBox: " FontAttributes="Bold" />
                                <Span Text="Binary selection (checked/unchecked)" />
                                <Span Text="&#x0a;&#x0a;" />
                                <Span Text="Switch: " FontAttributes="Bold" />
                                <Span Text="Toggle between on/off states with immediate effect" />
                                <Span Text="&#x0a;&#x0a;" />
                                <Span Text="Slider: " FontAttributes="Bold" />
                                <Span Text="Continuous value selection within a range" />
                                <Span Text="&#x0a;&#x0a;" />
                                <Span Text="Pickers: " FontAttributes="Bold" />
                                <Span Text="Date and time selection with platform-native UI" />
                                <Span Text="&#x0a;&#x0a;" />
                                <Span Text="MD3 Touch Targets:" FontAttributes="Bold" />
                                <Span Text="&#x0a;" />
                                <Span Text="• Minimum 48x48dp for all interactive controls" />
                                <Span Text="&#x0a;" />
                                <Span Text="• Primary color for active/selected states" />
                                <Span Text="&#x0a;" />
                                <Span Text="• Clear visual feedback for all interactions" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</uranium:UraniumContentPage>
