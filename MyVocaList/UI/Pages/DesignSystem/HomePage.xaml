<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage 
    x:Class="MyVocaList.UI.Pages.DesignSystem.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    Title="DS Home">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContainer}">

            <VerticalStackLayout>
                <Label Text="🧪 Headline.Large" StyleClass="Headline.Large" />
                <Label Text="🧪 Body.Medium" StyleClass="Body.Medium" />
                
                <Label Text="Design System" StyleClass="Headline.Large" />
                <Label Text="MyVocaList Brand Identity" StyleClass="Body.Medium" />
            </VerticalStackLayout>

            <Frame Style="{StaticResource WelcomeCard}">
                <VerticalStackLayout>
                    <Label Text="Welcome to MD3" StyleClass="Title.Large" />
                    <Label Text="This guide demonstrates UI/UX consistency across Android, iOS, and Windows using UraniumUI." StyleClass="Body.Medium" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Documentation and References" StyleClass="Title.Medium" />

            <Frame Style="{StaticResource FilledCard}">
                <VerticalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="Material Design 3: " StyleClass="Label.Large" />
                        <Label Text="https://m3.material.io/" StyleClass="Label.Small" TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUrlTapped" CommandParameter="https://m3.material.io/" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="Google Fonts: " StyleClass="Label.Large" />
                        <Label Text="https://fonts.google.com/" StyleClass="Label.Small" TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUrlTapped" CommandParameter="https://fonts.google.com/" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</uranium:UraniumContentPage>
