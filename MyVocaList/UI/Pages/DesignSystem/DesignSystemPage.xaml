<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="MyVocaList.UI.Pages.DesignSystem.DesignSystemPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    Title="UI Fundamentals">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContainer}">

            <VerticalStackLayout>
                <Label Text="MD3 Typography" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
                <Label Text="Headline Large" StyleClass="Headline.Large" />
                <Label Text="Headline Medium" StyleClass="Headline.Medium" />
                <Label Text="Body Large (Main Content)" StyleClass="Body.Medium" />
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Material Design 3 Buttons" StyleClass="Title.Medium" />

                <!-- UraniumUI styles on regular Button -->
                <Button Text="Filled Button" StyleClass="FilledButton" />
                <Button Text="Filled Tonal Button" StyleClass="FilledTonalButton" />
                <Button Text="Outlined Button" StyleClass="OutlinedButton" />
            </VerticalStackLayout>



            <VerticalStackLayout>
                <Label Text="Containers" StyleClass="Title.Medium" />

                <Frame Style="{StaticResource ElevatedCard}">
                    <Label Text="Elevated Card (With Shadow)" StyleClass="Body.Medium" />
                </Frame>

                <Frame Style="{StaticResource OutlinedCard}">
                    <Label Text="Card With Border" StyleClass="Body.Medium" />
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Icons" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                <Frame Style="{StaticResource OutlinedCard}">
                    <VerticalStackLayout>
                        <Label StyleClass="Body.Medium">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Available Icon Systems:" FontAttributes="Bold" />
                                    <Span Text="&#x0a;&#x0a;" />
                                    <Span Text="SVG Icons:" FontAttributes="Bold" />
                                    <Span Text="&#x0a;• Used in TabBar (bottom navigation)&#x0a;• Custom icons: home.svg, tune.svg&#x0a;• Dynamic theming support&#x0a;&#x0a;" />
                                    <Span Text="Material Symbols:" FontAttributes="Bold" />
                                    <Span Text="&#x0a;• 2,500+ icons available&#x0a;• Use FontImageSource in XAML&#x0a;• FontFamily=&quot;MaterialOutlined&quot;&#x0a;&#x0a;" />
                                    <Span Text="Note:" FontAttributes="Bold" />
                                    <Span Text="&#x0a;Material Symbols examples removed temporarily due to Android font loading performance issues." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</uranium:UraniumContentPage>