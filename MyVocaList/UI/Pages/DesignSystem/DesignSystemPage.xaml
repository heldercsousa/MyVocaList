<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="MyVocaList.UI.Pages.DesignSystem.DesignSystemPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    Title="UI Fundamentals">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContainer}">

            <VerticalStackLayout>
                <Label Text="Tipografia MD3" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
                <Label Text="Headline Large" StyleClass="Headline.Large" />
                <Label Text="Headline Medium" StyleClass="Headline.Medium" />
                <Label Text="Body Large (Conteúdo Principal)" StyleClass="Body.Medium" />
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Botões Material Design 3" StyleClass="Title.Medium" />

                <!-- UraniumUI styles on regular Button -->
                <Button Text="Filled Button" StyleClass="FilledButton" />
                <Button Text="Filled Tonal Button" StyleClass="FilledTonalButton" />
                <Button Text="Outlined Button" StyleClass="OutlinedButton" />
            </VerticalStackLayout>



            <VerticalStackLayout>
                <Label Text="Contêineres" StyleClass="Title.Medium" />

                <Frame Style="{StaticResource ElevatedCard}">
                    <Label Text="Card Elevado (Com Sombra)" StyleClass="Body.Medium" />
                </Frame>

                <Frame Style="{StaticResource OutlinedCard}">
                    <Label Text="Card Com Borda" StyleClass="Body.Medium" />
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="TabBar Icons" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                <Label Text="Custom SVG Icons" StyleClass="Title.Small" />
                <Label Text="The app uses custom SVG files for TabBar icons visible in the bottom navigation." StyleClass="Body.Medium" />

                <Frame Style="{StaticResource OutlinedCard}">
                    <VerticalStackLayout>
                        <Label StyleClass="Body.Medium">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Available Icons:" FontAttributes="Bold" />
                                    <Span Text="&#x0a;• home.svg, home_fill.svg, home_round.svg&#x0a;• tune.svg, tune_fill.svg, tune_round.svg&#x0a;&#x0a;" />
                                    <Span Text="Benefits:" FontAttributes="Bold" />
                                    <Span Text="&#x0a;• Works with Shell TabBar Icon property&#x0a;• Multiple variants for different states&#x0a;• Supports currentColor for dynamic theming&#x0a;• Minimal bundle size&#x0a;• Full control over design" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</uranium:UraniumContentPage>