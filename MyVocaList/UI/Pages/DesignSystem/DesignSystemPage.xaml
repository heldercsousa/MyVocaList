<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage 
    x:Class="MyVocaList.UI.Pages.DesignSystem.DesignSystemPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:v="clr-namespace:UraniumUI.Validations;assembly=UraniumUI.Validations.DataAnnotations"
    xmlns:local="clr-namespace:MyVocaList.UI.Pages.DesignSystem"
    xmlns:component="clr-namespace:MyVocaList.UI.Components"
    Title="UraniumUI Fundamentals"
    StyleClass="CardBackgroundGradient">



    <VerticalStackLayout>
        <VerticalStackLayout Style="{StaticResource SectionContainer}">
            <Label Text="Button Styles"   Style="{StaticResource LabelMedium}"/>
            <BoxView Margin="20,0"/>
            <FlexLayout JustifyContent="SpaceBetween" Wrap="Wrap">
                <Button StyleClass="ElevatedButton" Text="Elevated" />
                <Button StyleClass="ElevatedButton" IsEnabled="False" Text="Elevated OFF" />
            </FlexLayout>
            <BoxView Margin="20,0"/>
            <FlexLayout JustifyContent="SpaceBetween" Wrap="Wrap">
                <Button StyleClass="FilledButton" Text="Filled" />
                <Button StyleClass="FilledButton" IsEnabled="False" Text="Filled OFF" />
            </FlexLayout>
            <BoxView Margin="20,0"/>
            <FlexLayout JustifyContent="SpaceBetween" Wrap="Wrap">
                <Button StyleClass="FilledTonalButton" Text="Filled Tonal" />
                <Button StyleClass="FilledTonalButton" IsEnabled="False" Text="Filled Tonal OFF" />
            </FlexLayout>
            <BoxView Margin="20,0"/>
            <FlexLayout JustifyContent="SpaceBetween" Wrap="Wrap">
                <Button StyleClass="OutlinedButton" Text="Outlined" />
                <Button StyleClass="OutlinedButton" IsEnabled="False" Text="Outlined OFF" />
            </FlexLayout>
            <BoxView Margin="20,0"/>
            <FlexLayout JustifyContent="SpaceBetween" Wrap="Wrap">
                <Button StyleClass="TextButton" Text="Text" />
                <Button StyleClass="TextButton" IsEnabled="False" Text="Text OFF" />
            </FlexLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Style="{StaticResource SectionContainer}">
            <Label Text="Stateful Content View" Style="{StaticResource LabelMedium}"/>

            <BoxView Margin="0,20"/>
            <uranium:StatefulContentView>
                <Border Padding="20" BackgroundColor="{StaticResource Primary}" Stroke="{StaticResource Secondary}" StrokeShape="{RoundRectangle CornerRadius=20}">
                    <Label Text="This is a stateful view" TextColor="{StaticResource OnPrimary}" />
                </Border>
            </uranium:StatefulContentView>
        </VerticalStackLayout>
       
        
    </VerticalStackLayout>
    
