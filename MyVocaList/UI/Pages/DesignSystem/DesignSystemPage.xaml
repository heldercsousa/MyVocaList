<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    x:Class="MyVocaList.UI.Pages.DesignSystem.DesignSystemPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    Title="UI Fundamentals">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageContainer}">

            <VerticalStackLayout>
                <Label Text="Tipografia MD3" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />
                <Label Text="Headline Large" StyleClass="Headline.Large" />
                <Label Text="Headline Medium" StyleClass="Headline.Medium" />
                <Label Text="Body Large (Conteúdo Principal)" StyleClass="Body.Medium" />
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Botões Material Design 3" StyleClass="Title.Medium" />

                <!-- UraniumUI styles on regular Button -->
                <Button Text="Filled Button" StyleClass="FilledButton" />
                <Button Text="Filled Tonal Button" StyleClass="FilledTonalButton" />
                <Button Text="Outlined Button" StyleClass="OutlinedButton" />
            </VerticalStackLayout>



            <VerticalStackLayout>
                <Label Text="Contêineres" StyleClass="Title.Medium" />

                <Frame Style="{StaticResource ElevatedCard}">
                    <Label Text="Card Elevado (Com Sombra)" StyleClass="Body.Medium" />
                </Frame>

                <Frame Style="{StaticResource OutlinedCard}">
                    <Label Text="Card Com Borda" StyleClass="Body.Medium" />
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="Icon Comparison: SVG vs Material Symbols" StyleClass="Title.Medium" />
                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                <Label Text="Material Symbols Icons (UraniumUI)" StyleClass="Title.Small" />
                <Label Text="Outlined Variant" StyleClass="Body.Medium" />
                <FlexLayout>
                    <Button Text="Home"
                            StyleClass="FilledButton"
                            material:ButtonIcon.Icon="{x:Static m:MaterialOutlined.Home}" />
                    <Button Text="Tune"
                            StyleClass="FilledButton"
                            material:ButtonIcon.Icon="{x:Static m:MaterialOutlined.Tune}" />
                    <Button Text="Favorite"
                            StyleClass="FilledButton"
                            material:ButtonIcon.Icon="{x:Static m:MaterialOutlined.Favorite}" />
                </FlexLayout>

                <Label Text="Filled Variant" StyleClass="Body.Medium" />
                <FlexLayout>
                    <Button Text="Home"
                            StyleClass="FilledTonalButton"
                            material:ButtonIcon.Icon="{x:Static m:MaterialFilled.Home}" />
                    <Button Text="Tune"
                            StyleClass="FilledTonalButton"
                            material:ButtonIcon.Icon="{x:Static m:MaterialFilled.Tune}" />
                    <Button Text="Favorite"
                            StyleClass="FilledTonalButton"
                            material:ButtonIcon.Icon="{x:Static m:MaterialFilled.Favorite}" />
                </FlexLayout>

                <Label Text="Rounded Variant" StyleClass="Body.Medium" />
                <FlexLayout>
                    <Button Text="Home"
                            StyleClass="OutlinedButton"
                            material:ButtonIcon.Icon="{x:Static m:MaterialRound.Home}" />
                    <Button Text="Tune"
                            StyleClass="OutlinedButton"
                            material:ButtonIcon.Icon="{x:Static m:MaterialRound.Tune}" />
                    <Button Text="Favorite"
                            StyleClass="OutlinedButton"
                            material:ButtonIcon.Icon="{x:Static m:MaterialRound.Favorite}" />
                </FlexLayout>

                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                <Label Text="Custom SVG Icons (Current TabBar)" StyleClass="Title.Small" />
                <Label Text="These SVG files are used in AppShell TabBar. Check the bottom navigation to see them in action." StyleClass="Body.Medium" />

                <VerticalStackLayout>
                    <Label Text="• home.svg (outline)" StyleClass="Body.Medium" />
                    <Label Text="• home_fill.svg (filled)" StyleClass="Body.Medium" />
                    <Label Text="• home_round.svg (rounded)" StyleClass="Body.Medium" />
                    <Label Text="• tune.svg (outline)" StyleClass="Body.Medium" />
                    <Label Text="• tune_fill.svg (filled)" StyleClass="Body.Medium" />
                    <Label Text="• tune_round.svg (rounded)" StyleClass="Body.Medium" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="{StaticResource Outline}" />

                <Label Text="Comparison Summary" StyleClass="Title.Small" />
                <Frame Style="{StaticResource OutlinedCard}">
                    <VerticalStackLayout>
                        <Label StyleClass="Body.Medium">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="✓ Material Symbols:" FontAttributes="Bold" />
                                    <Span Text="&#x0a;• 2,500+ icons from Google Material Design&#x0a;• Works in Buttons, Labels, Cards&#x0a;• Cannot be used directly in Shell TabBar Icon property&#x0a;&#x0a;" />
                                    <Span Text="✓ Custom SVG Files:" FontAttributes="Bold" />
                                    <Span Text="&#x0a;• Perfect for TabBar icons (Shell Icon property)&#x0a;• Full control over design&#x0a;• Smaller bundle size&#x0a;• Supports currentColor for theming" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</uranium:UraniumContentPage>