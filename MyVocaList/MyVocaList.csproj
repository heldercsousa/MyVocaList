<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>-->
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<!-- net10.0 (no platform suffix) is used by the test project to reference ViewModels.
	     OutputType=Library prevents the app from building as an executable for that TFM. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Plugin.LocalNotification" />
		<PackageReference Include="Scrutor" />
	</ItemGroup>

	<PropertyGroup>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<RootNamespace>MyVocaList</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- CS8618: non-nullable uninitialized — covered by MVVM source generator patterns -->
		<!-- CS8601/CS8602/CS8603/CS8604/CS8625: nullable flow — suppressed project-wide per code-principles.md nullable policy -->
		<!-- CS8612/CS8613/CS8619/CS8622/CS8629/CS8767: interface/delegate nullability mismatches — pre-existing, non-breaking -->
		<NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8612;CS8613;CS8619;CS8622;CS8625;CS8629;CS8767;MVVMTK0045;XC0045</NoWarn>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>MyVocaList</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.myvocalist</ApplicationId>

		<!-- Versions — driven by MinVer git tags (vX.Y.Z[-label[.height]])
		     MinVerTagPrefix=v ensures tags like v0.1.0 and v0.2.0-alpha.3 are recognized.
		     ApplicationVersion: zero-padded MAJOR+MINOR+PATCH integer (e.g. 0.1.0 → 00100, monotonically increasing) -->
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<ApplicationDisplayVersion>$(MinVerVersion)</ApplicationDisplayVersion>
		<ApplicationVersion>$(MinVerMajor)$([System.String]::Format('{0:D2}', $(MinVerMinor)))$([System.String]::Format('{0:D2}', $(MinVerPatch)))</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
	  <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
	  <AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash_logo.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <AndroidResource Remove="NovaPasta\**" />
	  <AndroidResource Remove="Tmp\**" />
	  <Compile Remove="NovaPasta\**" />
	  <Compile Remove="Tmp\**" />
	  <EmbeddedResource Remove="NovaPasta\**" />
	  <EmbeddedResource Remove="Tmp\**" />
	  <MauiCss Remove="NovaPasta\**" />
	  <MauiCss Remove="Tmp\**" />
	  <MauiXaml Remove="NovaPasta\**" />
	  <MauiXaml Remove="Tmp\**" />
	  <None Remove="NovaPasta\**" />
	  <None Remove="Tmp\**" />
	</ItemGroup>

	<!-- Exclude MAUI app entry point from plain net10.0 TFM (used by test project) -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
	  <Compile Remove="MauiProgram.cs" />
	  <Compile Remove="App.xaml.cs" />
	  <MauiXaml Remove="App.xaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />

		<!-- DevExpress MAUI Packages -->
		<PackageReference Include="DevExpress.Maui.Core" />
		<PackageReference Include="DevExpress.Maui.CollectionView" />
		<PackageReference Include="DevExpress.Maui.Controls" />
		<PackageReference Include="DevExpress.Maui.Editors" />

		<!-- Serilog Packages -->
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="Serilog.Sinks.Debug" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="Serilog.Enrichers.Thread" />
		<!-- Crash Reporting -->
		<PackageReference Include="Sentry.Maui" />
		<PackageReference Include="Sentry.Serilog" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />

		<PackageReference Include="Redth.MauiDevFlow.Agent" Condition="'$(TargetFramework)' != 'net10.0'" />
		<PackageReference Include="MinVer" PrivateAssets="All" />
	</ItemGroup>

	<!-- Android transitive-dependency alignment.
	     Sentry.Maui pulls Xamarin.AndroidX.Lifecycle.Common.Java8 2.8.7.2, whose constraint
	     (Common >= 2.8.7.2 && < 2.8.8) conflicts with Lifecycle.Common 2.9.2.1 resolved by the
	     MAUI/AndroidX graph (NU1608). Central Package Management only pins versions for direct
	     references, so this explicit (Android-only) reference activates the 2.9.2.1 pin in
	     Directory.Packages.props, aligning Java8 with the resolved Common version. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Java8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Domain\MyVocaList.Domain.csproj" />
		<ProjectReference Include="..\Infra\MyVocaList.Infra.csproj" />
		<ProjectReference Include="..\Services\MyVocaList.Services.csproj" />
	</ItemGroup>

	<!-- Exclude DevExpress Samples from Release builds -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<None Include="UI\Pages\Samples\**\*.cs" />
		<None Include="UI\Pages\Samples\**\*.xaml" />
	</ItemGroup>
	<!-- Only include working CollectionView samples in Debug builds -->

	<ItemGroup>
		<!-- Embedded config — appsettings.json is gitignored (local DSN); template is committed -->
		<EmbeddedResource Include="appsettings.json" Condition="Exists('appsettings.json')" />
		<EmbeddedResource Include="appsettings.template.json" />
	</ItemGroup>

</Project>
