#!/bin/sh
# Local CI-substitute gate (solo, pre-production).
# Runs the test suite before allowing a commit that touches code, so a broken
# build or a red test can never be recorded. `dotnet test` transitively builds
# Domain, Contracts, Infra, Services AND the MAUI head (net10.0 lib) referenced
# by MyVocaList.Tests, so ViewModel/Component compile errors are caught too.
#
# Scope note: this gate does NOT build the Android head (XAML/XamlC). XAML is
# covered by the incremental-edit rule + emulator smoke tests. Keeping the gate
# to `dotnet test` keeps per-commit cost to seconds, not minutes.
#
# Docs-only / config-only commits skip the gate entirely.
# Intentional bypass (e.g. WIP checkpoint): `git commit --no-verify`.
#
# --- R-2 (SPEC-EVO T12b) ---
# BACKLOG.md is a generated view over item README.md frontmatter. This gate is
# deliberately BLOCKING: `regen --check` is a byte comparison with no false
# positives (unlike orphan_check.py's advisory heuristic, which guesses at
# intent and so must not block), and an advisory-only gate would defeat the
# core premise of generation -- a view that MAY be stale is worse than a
# hand-written one, because a reader cannot tell which state they are looking
# at. Fires only on commits that touch frontmatter-bearing files, so ordinary
# code-only commits pay nothing beyond the check above.

set -e

# Staged files added/copied/modified (ignore deletions and renames' old path).
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# Does the commit touch compilable code?
if ! printf '%s\n' "$STAGED" | grep -Eq '\.(cs|xaml)$'; then
  echo "pre-commit: no .cs/.xaml changes staged — skipping build+test gate."
else
  echo "pre-commit: code changes staged — running dotnet test (bypass with --no-verify)..."
  if ! dotnet test MyVocaList.Tests/MyVocaList.Tests.csproj -v q --nologo; then
    echo ""
    echo "pre-commit: BLOCKED — build or tests failed. Fix before committing."
    echo "            To commit anyway (e.g. an intentional WIP checkpoint):"
    echo "            git commit --no-verify"
    exit 1
  fi
  echo "pre-commit: build + tests green."
fi

# Does the commit touch BACKLOG frontmatter (item README.md, BACKLOG.md itself,
# or an archive month file)?
BACKLOG_TOUCHED=$(printf '%s\n' "$STAGED" | grep -E \
  '(^Docs/Management/.*/README\.md$|^Docs/Management/BACKLOG\.md$|^Docs/Management/backlog-archive/.*\.md$)') || true

if [ -n "$BACKLOG_TOUCHED" ]; then
  echo "pre-commit: BACKLOG-relevant files staged — running regen --check..."
  if ! python .claude/scripts/backlog/backlog_gen.py regen --check; then
    echo ""
    echo "pre-commit: BLOCKED — BACKLOG.md (or an archive) is stale relative to"
    echo "            item README.md frontmatter."
    echo "            Run: python .claude/scripts/backlog/backlog_gen.py regen"
    echo "            Then stage the regenerated files and retry the commit."
    echo "            To commit anyway (e.g. an intentional WIP checkpoint):"
    echo "            git commit --no-verify"
    exit 1
  fi
  echo "pre-commit: BACKLOG.md up to date."
fi

# --- R-3 (documented-command guard) ---
# Three real incidents were documentation describing a command that had
# never been run (an invented `reclaim.py` API, an invalid `--kind`
# choice, a `--status` value that parsed but silently matched nothing).
# `test_command_docs_guard.py` mechanically checks every documented
# `backlog_gen.py` / `reclaim.py` / `resume.py` invocation against the
# real parser/contract -- verb exists, flags exist, choices are valid,
# required args are present. This is deterministic (no guessed intent,
# unlike orphan_check.py's advisory heuristic) so it is safe to block on,
# same as the `regen --check` gate above. Runs only the guard test, not
# the whole suite, so a rules-only commit stays fast.
DOCS_TOUCHED=$(printf '%s\n' "$STAGED" | grep -E '^\.claude/.*\.md$|^CLAUDE\.md$') || true

if [ -n "$DOCS_TOUCHED" ]; then
  echo "pre-commit: .claude/CLAUDE.md docs staged — running documented-command guard..."
  if ! (cd .claude/scripts/backlog/tests && python -m unittest test_command_docs_guard -v); then
    echo ""
    echo "pre-commit: BLOCKED — a documented backlog_gen.py/reclaim.py/resume.py"
    echo "            invocation does not match the real script's contract."
    echo "            Fix the documentation (or the script, if it is wrong)."
    echo "            To commit anyway (e.g. an intentional WIP checkpoint):"
    echo "            git commit --no-verify"
    exit 1
  fi
  echo "pre-commit: documented-command guard passed."
fi

echo "pre-commit: commit allowed."
exit 0
