{
  "$schema": "https://mcp.context7.com/schema.json",
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "devexpress-maui": {
      "type": "http",
      "url": "https://gitmcp.io/DevExpress/maui-demo-app"
    },
    "playwright": {
      "command": "cmd",
      "args": [ "/c", "npx", "-y", "@playwright/mcp@latest", "--extension" ],
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${PLAYWRIGHT_MCP_EXTENSION_TOKEN}"
      }
    },
    "sqlite": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        "C:/Users/helde/source/repos/MyVocaList/.claude/MyVocaList.db"
      ],
      "_comment": "SQLite MCP database — auto-synced after 'dotnet ef database update' via PostToolUse hook in settings.json. Ensure current schema by running migrations before querying. Tests use TestDbContextFactory (fresh temp DB) so they always have current schema."
    }
  }
}
