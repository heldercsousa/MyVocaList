# ============================================
# .claudeignore - MyVocaList
# Updated: January 27, 2026
# ============================================

# Standard .NET build artifacts
[Bb]in/
[Oo]bj/

# Visual Studio files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider files
.idea/

# VS Code files
.vscode/

# Package files
*.nupkg
*.snupkg
[Pp]ackages/

# Temporary files and logs
temp/
*[Tt]emp/
*.log
*.tlog
*.cache

# Build outputs
[Dd]ebug/
[Rr]elease/
publish/
build/
artifacts/

# OS-specific files
.DS_Store
Thumbs.db

# Secret and credential files
*.env
*.pem
*.key
**/secrets/
**/credentials/

# MAUI build outputs
*.apk
*.aab
*.ipa
*.app
*.exe
*.dll
*.pdb
*.xaml.g.cs
*.designer.cs

# Native code outputs
*.so
*.dylib

# SQLite database files
*.db
*.db3
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.db-journal

# Test outputs
**/TestResults/
**/*.trx
**/TestData/**/*.json
**/TestData/**/*.xml
**/TestData/**/*.csv

# Migrations (don't modify old migrations)
**/Migrations/

# Console tools (not needed for main app development)
Console/**

# Large binary files in Docs
**/[Dd]ocs/**/*.pdf
**/[Dd]ocs/**/*.docx
**/[Dd]ocs/**/*.png
**/[Dd]ocs/**/*.jpg
**/[Dd]ocs/**/*.jpeg
**/[Dd]ocs/**/*.gif
**/[Dd]ocs/**/*.svg

# Changelog archive
**/[Dd]ocs/[Cc]hangelog/[Aa]rchive/**

# AI learning documentation (personal learning, not for Claude Code)
**/[Dd]ocs/[Gg]uides/[Aa][Ii]/**

# Guides folder (exclude by default)
**/[Dd]ocs/[Gg]uides/**

# Resources (binary files)
**/[Rr]esources/AppIcon/**
**/[Rr]esources/**/*.png
**/[Rr]esources/**/*.jpg
**/[Rr]esources/**/*.jpeg
**/[Rr]esources/**/*.gif
**/[Rr]esources/[Ff]onts/**/*.ttf
**/[Rr]esources/[Ss]trings/**/*.resx

# Batch files
*.bat
