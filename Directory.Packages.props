<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating/wildcard versions (e.g. 8.*, 2.*) in PackageVersion entries -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Suppress NU1507: multiple package sources without source mapping -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <!-- ================================================================ -->
  <!-- EF Core & SQLite                                                 -->
  <!-- ================================================================ -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- EF Core 10 / Microsoft.Data.Sqlite 10 pull SQLitePCLRaw.bundle_e_sqlite3 2.1.11
         transitively, whose SQLitePCLRaw.lib.e_sqlite3.* natives carry a known high-severity
         SQLite vulnerability (NU1903, GHSA-2m69-gcr7-jv3q) with no patch in the 2.1 line.
         The 3.x stack replaces the vulnerable lib.* packages with SourceGear.sqlite3
         (SQLite 3.50.4.5). Microsoft.Data.Sqlite.Core 10 requires core [2.1.11, ) with no
         upper bound, so 3.x is compatible. Activated via the direct reference in Infra. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageVersion Include="Plugin.LocalNotification" Version="14.1.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
  <!-- ================================================================ -->
  <!-- Microsoft Extensions                                             -->
  <!-- ================================================================ -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.3" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
  </ItemGroup>
  <!-- ================================================================ -->
  <!-- Serilog (normalized — was 4.2.0/4.3.1 drift between projects)  -->
  <!-- ================================================================ -->
  <ItemGroup>
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <!-- ================================================================ -->
  <!-- Crash Reporting                                                   -->
  <!-- ================================================================ -->
  <ItemGroup>
    <PackageVersion Include="Sentry.Maui" Version="5.*" />
    <PackageVersion Include="Sentry.Serilog" Version="5.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <!-- Aligns Xamarin.AndroidX.Lifecycle.Common.Java8 with the Lifecycle.Common 2.9.2.1
         resolved by the MAUI/AndroidX graph, resolving the NU1608 range conflict (Java8's
         default 2.8.7.2 caps Common at < 2.8.8). CPM only pins direct references, so this
         version takes effect via the Android-only PackageReference in MyVocaList.csproj. -->
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Common.Java8" Version="2.9.2.1" />
  </ItemGroup>
  <!-- ================================================================ -->
  <!-- .NET MAUI                                                        -->
  <!-- ================================================================ -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.41" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.41" />
    <PackageVersion Include="Microsoft.Maui.Essentials" Version="10.0.0" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="14.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>
  <!-- ================================================================ -->
  <!-- DevExpress MAUI                                                  -->
  <!-- ================================================================ -->
  <ItemGroup>
    <PackageVersion Include="DevExpress.Maui.CollectionView" Version="25.2.4" />
    <PackageVersion Include="DevExpress.Maui.Controls" Version="25.2.4" />
    <PackageVersion Include="DevExpress.Maui.Core" Version="25.2.4" />
    <PackageVersion Include="DevExpress.Maui.Editors" Version="25.2.4" />
  </ItemGroup>
  <!-- ================================================================ -->
  <!-- Dev Tools                                                        -->
  <!-- ================================================================ -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="6.*" />
    <PackageVersion Include="NuGet.Versioning" Version="6.*" />
    <PackageVersion Include="Redth.MauiDevFlow.Agent" Version="*" />
  </ItemGroup>
  <!-- ================================================================ -->
  <!-- String similarity                                                -->
  <!-- ================================================================ -->
  <ItemGroup>
    <PackageVersion Include="FuzzySharp" Version="2.0.2" />
  </ItemGroup>
  <!-- ================================================================ -->
  <!-- Test project                                                     -->
  <!-- ================================================================ -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.*" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageVersion Include="FsCheck.Xunit" Version="2.*" />
    <PackageVersion Include="Moq" Version="4.*" />
    <PackageVersion Include="xunit" Version="2.*" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>
</Project>