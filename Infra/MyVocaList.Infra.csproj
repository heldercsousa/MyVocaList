<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8603;CS8604;CS8625;CS8602</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FuzzySharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Overrides EF Core's transitive SQLitePCLRaw.bundle_e_sqlite3 2.1.11 (vulnerable
         lib.e_sqlite3.* natives, NU1903) with the 3.x stack (SourceGear.sqlite3 / SQLite
         3.50.4.5). Version pinned centrally in Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\MyVocaList.Domain.csproj" />
    <!-- D3/D4 (persisted-string-trimming/design.md § D3, D4): ValueConverters in
         EntityTypeConfiguration delegate to MyVocaList.Extensions.Strings string-trimming
         extension methods — Infra configures WHERE the trimming rule applies. MyVocaList.Extensions
         is a dependency-free leaf project (Task 6a), so this keeps strict DRY Onion ordering
         (no Infra -> Services edge). -->
    <ProjectReference Include="..\MyVocaList.Extensions\MyVocaList.Extensions.csproj" />
  </ItemGroup>

</Project>
